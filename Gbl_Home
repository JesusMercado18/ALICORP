nput: \"SolicitanteNombre\", mark: false, query: \"\" },\r\n        { input: \"FechaCreado\", mark: false, query: \"\" },\r\n        { input: \"EstadoActual\", mark: false, query: \"\" },\r\n        { input: \"Area\", mark: false, query: \"\" },\r\n            //SubArea\r\n        { input: \"SubArea\", mark: false, query: \"\" },\r\n        { input: \"Prioridad\", mark: false, query: \"\" },\r\n        { input: \"AprobadorNombre\", mark: false, query: \"\" },\r\n        { input: \"TipoSolicitud\", mark: false, query: \"\" },\r\n        { input: \"Gerencia\", mark: false, query: \"\" },\r\n        { input: \"ID\", mark: false, query: \"\" },\r\n        { input: \"SolicitanteCorreo\", mark: true, query: \r\n        \"(SolicitanteCorreo eq '\" & Var_ProfileUser.CorreoUsuario & \"' or ContactoDeRespaldo eq '\" & Var_ProfileUser.CorreoUsuario & \"')\"  \r\n        }\r\n    );\r\n    \r\n);\r\n//============================================ fin del odata\r\n\r\nUpdateContext({ menuSelected: 1});\r\n\r\nReset(DatePicker2);\r\nReset(DatePicker_SegTicket);\r\nReset(DatePicker_SegTicket_1);\r\n\r\n// GRAFICO 1\r\n/*Set(\r\n    varFechaFiltro;\r\n    DateAdd(\r\n        Today();\r\n        -30;\r\n        TimeUnit.Days\r\n    )\r\n);;*/\r\n\r\nSet(varRespuestaFlujo,'LCP-001_Flow_GlbHomeBoards'.Run(Text(DatePicker2.SelectedDate,\"yyyy-mm-dd\") & \"T00:00:00Z\",\"1\").ticketsjson);\r\n\r\nClearCollect(colMonthlyTickets,ForAll(Table(ParseJSON(varRespuestaFlujo)),{idmes: Value(Value.idmes),mes: Text(Value.mes),tickets: Value(Value.tickets)}));\r\n\r\n// 1️⃣ SIMULACIÓN FIEL DE DATAVERSE (12 MESES CON EL PICO DE ABRIL)\r\n/*ClearCollect(\r\n    colMonthlyTickets_demo; // Usamos el mismo nombre para que coincida con tu control de imagen\r\n    { idmes: \"1\"; mes: \"Enero\"; tickets: \"100\" };\r\n    { idmes: \"2\"; mes: \"Febrero\"; tickets: \"145\" };\r\n    { idmes: \"3\"; mes: \"Marzo\"; tickets: \"175\" };\r\n    { idmes: \"4\"; mes: \"Abril\"; tickets: \"300\" }; // El pico notable del reporte original\r\n    { idmes: \"5\"; mes: \"Mayo\"; tickets: \"210\" };\r\n    { idmes: \"6\"; mes: \"Junio\"; tickets: \"225\" };\r\n    { idmes: \"7\"; mes: \"Julio\"; tickets: \"300\" };\r\n    { idmes: \"8\"; mes: \"Agosto\"; tickets: \"1000\" };\r\n    { idmes: \"9\"; mes: \"Septiembre\"; tickets: \"380\" };\r\n    { idmes: \"10\"; mes: \"Octubre\"; tickets: \"300\" };\r\n    { idmes: \"11\"; mes: \"Noviembre\"; tickets: \"250\" };\r\n    { idmes: \"12\"; mes: \"Diciembre\"; tickets: \"280\" }\r\n);;*/\r\n\r\n// Control de proporciones dinámicas según la cantidad real de registros\r\nUpdateContext({\r\n    varTotalRegistros: CountRows(colMonthlyTickets),\r\n    varMaxTickets: Max(colMonthlyTickets, tickets),\r\n    varCanvasWidth: 1200,\r\n    varCanvasHeight: 240,\r\n    varPaddingX: 45 \r\n});\r\n\r\n// 4️⃣ Replicar EXACTAMENTE las líneas horizontales fijas\r\n\r\nSet(\r\n    varEscalaMax,\r\n    RoundUp(varMaxTickets / 100, 0) * 100\r\n);\r\n\r\n// 2️⃣ Transformar los puntos (CORREGIDO: Sin comillas en X e Y para igualar a Dataverse)\r\nClearCollect(\r\n    colChartPoints,\r\n    With(\r\n        {\r\n            YMinChart: 40,\r\n            YMaxChart: 190,\r\n            AnchoUtil: varCanvasWidth - (varPaddingX * 2),\r\n            StepX: (varCanvasWidth - (varPaddingX * 2)) / If(varTotalRegistros > 1, varTotalRegistros - 1, 1)\r\n        },\r\n        AddColumns(\r\n            colMonthlyTickets,\r\n            X, varPaddingX + (StepX * (idmes - Min(colMonthlyTickets, idmes))), // <-- X sin comillas\r\n            Y, If(varEscalaMax > 0, YMaxChart - ((tickets / varEscalaMax) * (YMaxChart - YMinChart)), YMaxChart) // <-- Y sin comillas\r\n        )\r\n    )\r\n);\r\n\r\n\r\n// 3️⃣ Compilar cadenas del SVG con sustitución regional (Comas por puntos)\r\nSet(\r\n    varSvgPoints,\r\n    Concat(\r\n        colChartPoints,\r\n        Substitute(Text(Coalesce(X, 0)), \",\", \".\") & \",\" & Substitute(Text(Coalesce(Y, 0)), \",\", \".\") & \" \"\r\n  