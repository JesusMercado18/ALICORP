Screens:
  Gbl_Comunicado:
    Properties:
      Fill: =ColorValue(Var_ColorFondoLateral)
      LoadingSpinnerColor: =RGBA(0, 120, 212, 1)
      OnVisible: |-
        =//----Variables-----
        UpdateContext({menuSelected: 5});
        UpdateContext({Var_Ctx_MostrarItems : false });
        UpdateContext({varOpenDropDownSpvCmcGerencia : false });
        UpdateContext({varOpenDropDownSpvCmcArea : false });
        UpdateContext({varOpenDropDownSpvCmcEstado : false });
        UpdateContext({var_RangeDatePicker : false });
        UpdateContext({var_RangeDatePicker_SelectMonthYear : false });
        UpdateContext({var_RangeDatePicker_DateStart : Blank() });
        UpdateContext({var_RangeDatePicker_DateEnd : Blank() });
        UpdateContext({Var_SpvCmcDisplayModeArea: false});
        UpdateContext({varSpvCmcEstadoSelected: Blank()});
        UpdateContext({varSpvCmcGerenciaSelectec: Blank()});
        UpdateContext({Var_SpvCmcLoadingSpinnerVisible: true});

        //Reset(SpvCmc_LblEstadoSeleccionada);;
        Reset(SpvCmc_LblGerenciaSeleccionada);

        Switch(Var_RolSistema,
            "Administrador",
                ClearCollect(colQuerysSpvComunicados,
                    { input: "ID",               mark: false, query: "" },
                    { input: "Gerencia",         mark: false, query: "" },
                    { input: "Pais",             mark: false, query: "" },
                    { input: "Cabecera",         mark: false, query: "" },
                    { input: "Cuerpo",           mark: false, query: "" },
                    { input: "Imagen",           mark: false, query: "" },
                    { input: "UsuarioCreador",   mark: false, query: "" },
                    { input: "FechaCreacion",    mark: false, query: "" },
                    { input: "FechaFin",         mark: false, query: "" },
                    { input: "Estado",           mark: false, query: "" },
                    { input: "EstadoComunicado", mark: false, query: "" },
                    { input: "EsVisibleHoy",     mark: false, query: "" },
                    { input: "Creado",           mark: false, query: "" },
                    { input: "FechaInicio",      mark: false, query: "" },
                    { input: "DiaInicio",        mark: false, query: "" },
                    { input: "DiaFin",           mark: false, query: "" },
                    { input: "MesInicio",        mark: false, query: "" },
                    { input: "MesFin",           mark: false, query: "" },
                    { input: "Recurrente",       mark: false, query: "" },
                    { input: "DatosAdjuntos",    mark: false, query: "" }
                ),
            "Supervisor",
            ClearCollect(colQuerysSpvComunicados,
                    { input: "ID",               mark: false, query: "" },
                    { input: "Gerencia",         mark: true, query: "(substringof('" & Var_ProfileUser.Gerencia & "', Gerencia) or Gerencia eq 'Todos' or Gerencia eq null)" },
                    { input: "Pais",             mark: true, query: "(substringof('" & Var_ProfileUser.Pais & "', Pais) or Pais eq 'Todos' or Pais eq null)" },
                    { input: "Cabecera",         mark: false, query: "" },
                    { input: "Cuerpo",           mark: false, query: "" },
                    { input: "Imagen",           mark: false, query: "" },
                    { input: "UsuarioCreador",   mark: false, query: "" },
                    { input: "FechaCreacion",    mark: false, query: "" },
                    { input: "FechaFin",         mark: false, query: "" },
                    { input: "Estado",           mark: false, query: "" },
                    { input: "EstadoComunicado", mark: false, query: "" },
                    { input: "EsVisibleHoy",     mark: false, query: "" },
                    { input: "Creado",           mark: false, query: "" },
                    { input: "FechaInicio",      mark: false, query: "" },
                    { input: "DiaInicio",        mark: false, query: "" },
                    { input: "DiaFin",           mark: false, query: "" },
                    { input: "MesInicio",        mark: false, query: "" },
                    { input: "MesFin",           mark: false, query: "" },
                    { input: "Recurrente",       mark: false, query: "" },
                    { input: "DatosAdjuntos",    mark: false, query: "" }
                ),
            //Resultado predeterminado
            ClearCollect(colQuerysSpvComunicados,
                    { input: "ID",               mark: false, query: "" },
                    { input: "Gerencia",         mark: true, query: "(substringof('" & Var_ProfileUser.Gerencia & "', Gerencia) or Gerencia eq 'Todos' or Gerencia eq null)" },
                    { input: "Pais",             mark: true, query: "(substringof('" & Var_ProfileUser.Pais & "', Pais) or Pais eq 'Todos' or Pais eq null)" },
                    { input: "Cabecera",         mark: false, query: "" },
                    { input: "Cuerpo",           mark: false, query: "" },
                    { input: "Imagen",           mark: false, query: "" },
                    { input: "UsuarioCreador",   mark: false, query: "" },
                    { input: "FechaCreacion",    mark: false, query: "" },
                    { input: "FechaFin",         mark: false, query: "" },
                    { input: "Estado",           mark: true, query: "Estado eq 'Vigente'" },
                    { input: "EstadoComunicado", mark: true, query: "EstadoComunicado eq 'Activo'" },
                    { input: "EsVisibleHoy",     mark: true, query: "EsVisibleHoy eq 1" },
                    { input: "Creado",           mark: false, query: "" },
                    { input: "FechaInicio",      mark: false, query: "" },
                    { input: "DiaInicio",        mark: false, query: "" },
                    { input: "DiaFin",           mark: false, query: "" },
                    { input: "MesInicio",        mark: false, query: "" },
                    { input: "MesFin",           mark: false, query: "" },
                    { input: "Recurrente",       mark: false, query: "" },
                    { input: "DatosAdjuntos",    mark: false, query: "" }
                )
        );

        Set(Var_GridPageSizeSpvComunicados, 5);
        Set(Var_CurrentPageSpvComunicados, 1);
        // Configuración para el motor:
        Set(Var_TargetIDSpvComunicados, 0);
        Set(Var_DirectionSpvComunicados, "NEXT");
        Set(Var_IsIndividualSpvComunicados, false);

        Select(Spv_btn_MotorPaginacionComunicados); // <--- Ejecuta la lógica

        UpdateContext({Var_SpvCmcLoadingSpinnerVisible: false});
