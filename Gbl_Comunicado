      - Spv_btn_MotorPaginacionComunicados:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =ColorFade(Self.Fill, -15%)
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(166, 166, 166, 1)
            Fill: =RGBA(56, 96, 178, 1)
            Font: =Font.'Open Sans'
            Height: =34
            HoverBorderColor: =ColorFade(Self.BorderColor, 20%)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =ColorFade(RGBA(56, 96, 178, 1), -20%)
            OnSelect: |-
              =UpdateContext({Var_SpvCmcLoadingSpinnerVisible: true});
              //----Flujo----
              Set(Var_ResponseSpvComunicados,
                  'LCP-001_Flow_SpvPaginacionComunicados'.Run(
                      //Var_GridPageSizeSpvComunicados; 0;
                      If(Var_IsIndividualSpvComunicados, Text(varTotalRegistrosComunicados), Text(Var_GridPageSizeSpvComunicados)),
                      Text(Var_TargetIDSpvComunicados),
                      Concat( Filter(colQuerysSpvComunicados, mark), query, " and " ), //and
                      //"NEXT"
                      Var_DirectionSpvComunicados
                  )
              );
              //----Variables respuesta flujo----
              Set(TotalItemSpvComunicados, Value(ParseJSON(Var_ResponseSpvComunicados.totalitems)));
              Set(Var_DataSpvComunicados, Table(ParseJSON(Var_ResponseSpvComunicados.response)));
              //----Datos para llenar galeria de comunicados---- 
              Clear(objGalleryDataSpvComunicados);
              ForAll(
                  //FirstN(Var_DataSpvComunicados;Var_GridPageSizeSpvComunicados);
                  If(Var_IsIndividualSpvComunicados,
                      LastN(FirstN(Var_DataSpvComunicados, varTotalRegistrosComunicados), Min(Var_GridPageSizeSpvComunicados, CountRows(Var_DataSpvComunicados) - (Var_GridPageSizeSpvComunicados * (Var_CurrentPageSpvComunicados - 1)))),
                      FirstN(Var_DataSpvComunicados, Var_GridPageSizeSpvComunicados)
                  ),
                  Collect(
                      objGalleryDataSpvComunicados,
                      {
                          ID:                 ThisRecord.Value.ID,
                          Gerencia:           ThisRecord.Value.Gerencia,        
                          Pais:               ThisRecord.Value.Pais,          
                          Cabecera:           ThisRecord.Value.Cabecera,    
                          Cuerpo:             ThisRecord.Value.Cuerpo,           
                          Imagen:             Text(ThisRecord.Value.ImagenBase64),
                          URLimagen:          ThisRecord.Value.URLimagen,
                          UsuarioCreador:     ThisRecord.Value.UsuarioCreador, 
                          FechaCreacion:      ThisRecord.Value.FechaCreacion,
                          FechaInicio:        ThisRecord.Value.FechaInicio,    
                          FechaFin:           ThisRecord.Value.FechaFin,  
                          DiaInicio:          ThisRecord.Value.DiaInicio,    
                          DiaFin:             ThisRecord.Value.DiaFin,     
                          MesInicio:          ThisRecord.Value.MesInicio,    
                          MesFin:             ThisRecord.Value.MesFin,     
                          Estado:             ThisRecord.Value.Estado,     
                          Creado:             ThisRecord.Value.Creado,      
                          EstadoComunicado:   ThisRecord.Value.EstadoComunicado,
                          Recurrente:         ThisRecord.Value.Recurrente,
                          TipoRecurrente:     ThisRecord.Value.TipoRecurrente,
                          EsVisibleHoy:       ThisRecord.Value.EsVisibleHoy,
                          TipoPublicacion:    ThisRecord.Value.TipoPublicacion
                      }
                  )
              );

              // 4. Actualizar estados de navegación
              Set(
                  Var_HasNextSpvComunicados, 
                  (Var_CurrentPageSpvComunicados * Var_GridPageSizeSpvComunicados) < TotalItemSpvComunicados
              );
              Set(
                  Var_HasPrevSpvComunicados, 
                  Var_CurrentPageSpvComunicados > 1
              );
              UpdateContext({Var_SpvCmcLoadingSpinnerVisible: false});
            PressedBorderColor: =Self.Fill
            PressedColor: =Self.Fill
            PressedFill: =Self.Color
            Text: ="+"
            Visible: =false
            Width: =30
