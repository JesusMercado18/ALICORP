                        BorderThickness: =0
                        Color: =ColorValue(Var_ColorGray)
                        DisabledBorderColor: =RGBA(166, 166, 166, 1)
                        Fill: =Color.Transparent
                        Font: =Font.'Open Sans'
                        Height: =30
                        HoverBorderColor: =ColorFade(Self.BorderColor, 20%)
                        HoverColor: =ColorValue(Var_ColorGray)
                        HoverFill: =ColorValue(Var_ColorFadeBoton)
                        OnSelect: |-
                          =// 1. Asignar variable local y cerrar dropdown
                          UpdateContext({
                              varSpvCmcGerenciaSelectec: ThisItem, 
                              varOpenDropDownSpvCmcGerencia: false
                          });

                          // 2. Actualizar las áreas correspondientes a la gerencia
                          ClearCollect(
                              colUpdateSpvNvCmcAreaComunidado, 
                              Filter('LCP-001_List_GerenciaArea', Gerencia = ThisItem.Value).Area
                          );

                          // 3. Apagamos el filtro de EsVisibleHoy (para que permita ver históricos/vencidos si se combina con el filtro de Estado)
                          Patch(
                              colQuerysSpvComunicados,
                              LookUp(colQuerysSpvComunicados, input = "EsVisibleHoy"),
                              { mark: false }
                          );

                          // 4. Búsqueda por la Gerencia seleccionada O "Todos"
                          If(
                              IsBlank(Trim(Self.Text)),
                              Patch(
                                  colQuerysSpvComunicados, 
                                  LookUp(colQuerysSpvComunicados, input = "Gerencia"), 
                                  { mark: false, query: "" }
                              ),
                              Patch(
                                  colQuerysSpvComunicados, 
                                  LookUp(colQuerysSpvComunicados, input = "Gerencia"), 
                                  { 
                                      mark: true, 
                                      // Inyectamos el OR para garantizar que los comunicados globales (Todos) jamás se oculten
                                      query: "(substringof('" & Self.Text & "', Gerencia) or substringof('Todos', Gerencia))" 
                                  }
                              )
                          );

                          // 5. Habilitar control dependiente, resetear paginación y ejecutar flujo
                          UpdateContext({Var_SpvCmcDisplayModeArea: true});
                          Select(Spv_btn_MotorPaginacionComunicados); // <--- Ejecuta la lógica
                          //Set(Var_CurrentPageSpvComunicados; 1);;
                          //Select(SpvCmc_BtnRefreshBusquedaGerencia);;
                        PressedBorderColor: =Self.Fill
                        PressedColor: =ColorValue(Var_ColorGray)
                        PressedFill: =ColorValue(Var_ColorFadeBoton)
                        Size: =12
                        Text: =ThisItem.Value
                        Width: =Parent.TemplateWidth
