      - Gbl_btnIngresar:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =ColorValue(Var_ColorHoverBoton)
            BorderThickness: =1
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(166, 166, 166, 1)
            DisplayMode: |-
              =If(
              Not(IsBlank(Gbl_CbxLogin.Selected.Rol)),
              DisplayMode.Edit,
              DisplayMode.Disabled
              )
            Fill: =ColorValue(Var_ColorBotonIngresar)
            Font: =Font.'Open Sans'
            HoverBorderColor: =ColorFade(Self.BorderColor, 20%)
            HoverColor: =ColorValue(Var_ColorBlanco)
            HoverFill: =ColorFade(Self.Fill, 0.10)
            OnSelect: "=//Refresh('LCP-001_List_Usuarios');;\n\nIf(Var_ProfileUser.Estado = \"Activo\",\n\n//Si el usuario es activo\n\n\n// Variable que guar el rol con mayor jerarquia\nSet(\n    Var_RolSistema, \n    Gbl_CbxLogin.Selected.Rol\n);\n\n//Navegar a la pantalla del rol con mayor jerarquia que tenga el usuario\nIf(CountRows(colRolesUsuario) = 0,\n\n//Si no tiene asignado ningun rol salta un mensaje con componente que diga que no tiene asignado rol\nSelect(Anl_TimerWarningBienvenida),\n\n// creamos una coleccion de los accesos que tiene el usuario\nClearCollect(\n    colAccesosUsuario,\n    Filter(\n        AddColumns(\n            colMatrizAcceso,\n            RolesPermitidos, \n            ForAll(Table(ParseJSON(ThisRecord.Rol)), Text(Value.Value))\n        ),\n        Var_RolSistema in RolesPermitidos\n    )\n)\n;\n\n// construimos un objeto para acceder a las vistas y funciones que retornan un valor booleano\nSet(\n    Var_MatrizAccesosApp,\n    {\n        // ==========================================\n        // MÓDULOS DE LA APP (VISTAS)\n        // ==========================================\n        Mod_Solicitante: !IsBlank(LookUp(colAccesosUsuario, Vista = VarModulo.Solicitante)),\n        Mod_Administracion: !IsBlank(LookUp(colAccesosUsuario, Vista = VarModulo.Administracion)),\n        Mod_Atencion: !IsBlank(LookUp(colAccesosUsuario, Vista = VarModulo.Atencion)),\n        Mod_GestionAprobacion: !IsBlank(LookUp(colAccesosUsuario, Vista = VarModulo.GestionAprobacion)),\n        Mod_Cierre: !IsBlank(LookUp(colAccesosUsuario, Vista = VarModulo.Cierre)),\n\n        // ==========================================\n        // FUNCIONALIDADES DETALLADAS\n        // ==========================================\n        // Módulo de solicitante\n        CrearTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MS_CrearTicket && Vista = VarModulo.Solicitante  )), // Nuevo ticket\n        SubsanaTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MS_SubsanaTicket  && Vista = VarModulo.Solicitante)), // En revisión\n        \n        // Módulo de administración\n        ConfigTipoSolicitud: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MAD_ConfigTipoSolicitud  && Vista = VarModulo.Administracion)),\n        ConfigNotificaciones: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MAD_ConfigNotificaciones  && Vista = VarModulo.Administracion)),\n        CrearComunicados: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MDC_CrearComunicados)),\n        CrearSoluciones: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MDS_CrearSoluciones)),\n        ConfigAccesos: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MAD_ConfigAccesos  && Vista = VarModulo.Administracion)),\n        \n        // Módulo de atención del responsable de atención\n        ObservarTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MA_ObservarTicket  && Vista = VarModulo.Atencion )), // Observar ticket\n        AtencionTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MA_AtencionTicket  && Vista = VarModulo.Atencion)), // En proceso\n        ReasignarTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MA_ReasignarTicket  && Vista = VarModulo.Atencion)), // Reasingar \n        DerivarTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MA_DerivarTicket  && Vista = VarModulo.Atencion)), // Derivar\n        SolicitarAprobacionTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MA_SolicitarAprobacionTicket  && Vista = VarModulo.Atencion)), // En espera de aprobación\n        ResolverTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MA_ResolverTicket  && Vista = VarModulo.Atencion)), // En Espera de aprobación -> Resuelto \n        // agregar el rechazo del ticket del analista\n        MA_RechazarTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MA_RechazarTicket  && Vista = VarModulo.Atencion)),\n        \n        // Módulo de gestión de aprobación\n        SolicitarReactivarTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MGA_SolicitarReactivarTicket  && Vista = VarModulo.GestionAprobacion)), // Analista\n        ReactivarTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MGA_ReactivarTicket  && Vista = VarModulo.GestionAprobacion)), // Supervisor / Gerente \n        GestionRechazarTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MGA_RechazarTicket  && Vista = VarModulo.GestionAprobacion)),\n        GestionAprobarTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MGA_AprobarTicket  && Vista = VarModulo.GestionAprobacion)),\n        \n        // Módulo de cierre\n        NPS: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MC_NPS  && Vista = VarModulo.Cierre)), \n        RechazarTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MC_RechazarTicket  && Vista = VarModulo.Cierre)), // Rechazar solución\n        SolucionarTicket: !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MC_SolucionarTicket  && Vista = VarModulo.Cierre)) // Cerrar ticket\n    }\n);\n\n// Menú dinámico \nClearCollect(\n    colMenuGeneral,\n    \n    // 1. HOME\n    If(Var_RolSistema <> Var_RolApp.RolSolicitante,\n    { Title: \"Home\", Id: 1, Pantalla: Gbl_Home, Ico: home, child: false, itemsSubChild: Table() },\n    Blank()\n    ),\n    \n    // 2. CATÁLOGO\n    { Title: \"Catálogo\", Id: 2, Pantalla: Gbl_Catalogo, Ico: catalogo, child: false, itemsSubChild: Table() },\n    \n    // 3. TICKET\n    { Title: \"Ticket\", Id: 3, Pantalla: Gbl_Ticket, Ico: ticket, child: false, itemsSubChild: Table() },\n\n    If(Var_RolSistema = Var_RolApp.RolSupervisor,\n    { Title: \"Analistas\", Id: 10, Pantalla: Spv_Analistas, Ico: usuarios, child: false, itemsSubChild: Table() },\n    Blank()\n    ),\n\n    //Spv_Analistas\n    // 9. APROBACIONES\n    { Title: \"Aprobaciones\", Id: 9, Pantalla: Gbl_Ticket, Ico: cheque, child: false, itemsSubChild: Table() },\n\n    // 4. CONFIGURACIÓN (Módulo de Administración)\n    If(\n        !IsBlank(LookUp(colAccesosUsuario, Vista = VarModulo.Administracion)),\n        {\n            Title: \"Configuración\", \n            Id: 4, \n            Pantalla: Blank(), \n            Ico: configuracion, \n            child: true, \n            itemsSubChild: Filter(\n                Table(\n                    // Submenú: Solicitudes\n                    If(\n                        !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MAD_ConfigTipoSolicitud && Vista = VarModulo.Administracion)),\n                        { Title: \"Solicitudes\", Id: \"4.1\", Pantalla: Adm_TipoSolicitudes },\n                        { Title: \"\", Id: \"4.1\", Pantalla: App.ActiveScreen } \n                    ),\n                    // Submenú: Notificaciones\n                    If(\n                        !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MAD_ConfigNotificaciones && Vista = VarModulo.Administracion)),\n                        { Title: \"Notificaciones\", Id: \"4.2\", Pantalla: App.ActiveScreen }, // Cambia por tu pantalla real si la tienes\n                        { Title: \"\", Id: \"4.2\", Pantalla: App.ActiveScreen }\n                    ),\n                    // Submenú: Catálogos del sistema\n                    { Title: \"\", Id: \"4.3\", Pantalla: App.ActiveScreen }, // Se queda vacío temporalmente si no hay pantalla asociada\n                    \n                    // Submenú: Accesos\n                    If(\n                        !IsBlank(LookUp(colAccesosUsuario, Funcionalidad = VarFuncionalidad.MAD_ConfigAccesos && Vista = VarModulo.Administracion)),\n                        { Title: \"Accesos\", Id: \"4.4\", Pantalla: Adm_Accesos },\n                        { Title: \"\", Id: \"4.4\", Pantalla: App.ActiveScreen }\n                    ),\n                    // Submenú: Accesos\n                    If(\n                        Var_RolSistema = Var_RolApp.RolAdministrador,\n                        { Title: \"Roles y agrupadores\", Id: \"4.5\", Pantalla: Adm_RolesAgrupadores },\n                        { Title: \"\", Id: \"4.5\", Pantalla: App.ActiveScreen }\n                    ),\n                    If(\n                        Var_RolSistema = Var_RolApp.RolAdministrador,\n                        { Title: \"Catálogos Sistema\", Id: \"4.6\", Pantalla: Gbl_CatalogoSistema },\n                        { Title: \"\", Id: \"4.5\", Pantalla: App.ActiveScreen }\n                    )\n                ),\n                // AQUÍ EL CAMBIO CLAVE: Ahora que el If controla el registro entero, \n                // si el usuario no tiene acceso, el título será \"\" y el Filter lo eliminará.\n                Title <> \"\"\n            )\n        },\n        // Registro de escape homologado si no tiene nada de Administración\n        { Title: \"\", Id: 0, Pantalla: Blank(), Ico: configuracion, child: false, itemsSubChild: Table() }\n    ),\n    \n    // 5. COMUNICADOS\n    { Title: \"Comunicados\", Id: 5, Pantalla: Gbl_Comunicado, Ico: comunicados, child: false, itemsSubChild: Table() },\n    \n    // 6. SOLUCIONES\n    { Title: \"Soluciones\", Id: 6, Pantalla: Blank(), Ico: soluciones, child: false, itemsSubChild: Table() },\n    \n    // 7. USUARIOS\n\n    If(Var_RolSistema = Var_RolApp.RolAdministrador,\n    { Title: \"Usuarios\", Id: 7, Pantalla: Adm_Usuarios, Ico: usuarios, child: false, itemsSubChild: Table() },\n    Blank()\n    ),\n\n    // 8. LOGOUT\n    { Title: \"Logout\", Id: 8, Pantalla: Gbl_Bienvenida, Ico: logout, child: false, itemsSubChild: Table() }\n);\n\n// LIMPIEZA FINAL DEL MENU PRINCIPAL\nClearCollect(colMenuGeneral, Filter(colMenuGeneral, Title <> \"\"));\n\n     If(Var_RolSistema = Var_RolApp.RolSolicitante,\n\n        Navigate(Gbl_Ticket, Transition.Push),\n        Navigate(Gbl_Home, Transition.Push)\n     \n     \n     )   \n\n),\n//Si el usuario es inactivo\nUpdateContext({OpenAlertWarnning: true, Var_Ctx_Inactivo: true, Var_Ctx_MensajeInactivo: \"Usted no tiene una cuenta activa para ingresar a la aplicación\"})\n)\n"
