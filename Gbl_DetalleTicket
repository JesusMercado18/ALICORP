Screens:
  Gbl_DetalleTicket:
    Properties:
      Fill: = Color.White
      LoadingSpinnerColor: =RGBA(56, 96, 178, 1)
      OnVisible: "=Concurrent(\nReset(Spv_RichComentariosDetalleTicket_1),\nReset(Gbl_Spv_AttachmentDetalleTicket_1),\nReset(Sol_Cbx_DetalleNuevoTicketAprobador),\nReset(Sol_Cbx_NuevoTicketGerencia_12),\n//13/06/2026\n//Se agrega el caso por la resolucion del requerimiento REQ_CC2_15\nUpdateContext({varUsuarioAprobador: LookUp('LCP-001_List_Usuarios', CorreoUsuario = Var_SpvTicketSeleccionada.AprobadorCorreo)})\n);\n\nSet(\n    Var_EstadoTicketSeleccionado,\n    Var_SpvTicketSeleccionada.Estado\n);\nUpdateContext(\n    {\n        varEstadoSelected: Blank(),\n        varGerenciaSelected: Blank(),\n        varUpdateAreaSelected: Blank(),\n        varUpdateSubAreaSelected: Blank(),\n        varUpdatePaisSelected: Blank(),\n        varUpdateSociedadSelected: Blank(),\n        varUpdateAtendidoPorSelected: Blank(),\n        varUpdateNivelConfidencialidadSelected: Blank(),\n        varUpdateAnteriorNombreAtendidoPorSelected: Blank(),\n        varUpdateAnteriorCorreoAtendidoPorSelected: Blank(),\n        MensajeSatisfactorio: \"\"//;\n        //varUpdateMotivoDerivacionSelected: Blank()\n    }\n);\nUpdateContext({varUpdateNivelConfidencialidadSelected: {Value: Var_SpvTicketSeleccionada.NivelDeConfidencialidad}});\n\nUpdateContext({Var_Ctx_ModalConfirmacion: false, Var_Ctx_OperacionCatalogo: false});\nUpdateContext({varUpdateClicAtendidoPorEliminado: false});\nUpdateContext(\n    {\n        varOpenDropDownEstadoTransicion: false,\n        varOpenDropDownGerencia: false,\n        varOpenDropDownUpdateArea: false,\n        varOpenDropDownUpdateSubArea: false,\n        varOpenDropDownUpdateSociedad: false,\n        varOpenDropDownUpdateAtendidoPor: false,\n        varOpenDropDownUpdateMotivoDerivacion: false,\n        varOpenDropDownUsuario:false,\n        varOpenDropDownArea:false\n    }\n);\n\nConcurrent(\nClear(colUpdateGerenciaSpv),\nClear(colUpdateAreaSpv),\nClear(colUpdateSubAreaSpv),\nClear(colUpdatePaisSpv),\nClear(colUpdateSociedadSpv),\nClear(colUpdateAtendidoPorSpv),\nUpdateContext({menuSelected: 3}),\nClear(colDiscusionTicketSpv)\n);\n\nClearCollect(colTrackingTicketsSpv, Filter('LCP-001_List_TrackingTicketSolicitud', Codigo = Text(Var_SpvTicketSeleccionada.Codigo)) );\n\nIf(IsEmpty(colTrackingTicketsSpv), \n\n    If(Len(Trim(PlainText(Var_SpvTicketSeleccionada.Comentario))) > 0,\n        Collect(colDiscusionTicketSpv,\n            {\n\n                Image: Var_SpvTicketTracking.Author.Picture, \n                UserName: Var_SpvTicketTracking.Author.DisplayName, \n                FechaCreado: Var_SpvTicketTracking.FechaModificado, \n                Comentario: Var_SpvTicketSeleccionada.Comentario, // Usamos un nombre genérico para el texto\n                Tipo: \"Comentario\"\n                \n            }\n        )\n    );\n\n    // 2. Si existe un motivo, crear otra fila independiente\n    If(Not(IsBlank(Var_SpvTicketSeleccionada.Motivo)),\n        Collect(colDiscusionTicketSpv,\n            {\n                Image: Var_SpvTicketTracking.Author.Picture, \n                UserName: Var_SpvTicketTracking.Author.DisplayName, \n                FechaCreado: Var_SpvTicketTracking.FechaModificado,\n                Comentario:$\"{If(IsBlank(Var_SpvTicketSeleccionada.Motivo),\"\",\"Motivo: \"&Var_SpvTicketSeleccionada.Motivo)}{\"</br>\"}{If(IsBlank(Var_SpvTicketSeleccionada.MotivoObservacion),\"\",\"Comentario: \"&Var_SpvTicketSeleccionada.MotivoObservacion)}\",\n                Tipo: \"Motivo\" \n            }\n        )\n    ),\n    If( Var_SpvTicketSeleccionada.Estado = Last(colTrackingTicketsSpv).EstadoActual  ,\n        If(Var_SpvTicketSeleccionada.ReAsignado || Var_SpvTicketSeleccionada.Derivado,\n        If(Len(Trim(PlainText(Var_SpvTicketSeleccionada.Comentario))) > 0,\n            Collect(colDiscusionTicketSpv,\n                {\n                    Image: Var_SpvTicketTracking.Author.Picture, \n                    UserName: Var_SpvTicketTracking.Author.DisplayName, \n                    FechaCreado: Var_SpvTicketTracking.FechaModificado, \n                    Comentario: Var_SpvTicketSeleccionada.Comentario, // Usamos un nombre genérico para el texto\n                    Tipo: \"Comentario\"\n                }\n            )\n        );\n\n        // 2. Si existe un motivo, crear otra fila independiente\n        If(Not(IsBlank(Var_SpvTicketSeleccionada.Motivo)),\n            Collect(colDiscusionTicketSpv,\n                {\n                    Image: Var_SpvTicketTracking.Author.Picture, \n                    UserName: Var_SpvTicketTracking.Author.DisplayName, \n                    FechaCreado: Var_SpvTicketTracking.FechaModificado,\n                    Comentario:$\"{If(IsBlank(Var_SpvTicketSeleccionada.Motivo),\"\",\"Motivo: \"&Var_SpvTicketSeleccionada.Motivo)}{\"</br>\"}{If(IsBlank(Var_SpvTicketSeleccionada.MotivoObservacion),\"\",\"Comentario: \"&Var_SpvTicketSeleccionada.MotivoObservacion)}\",\n                    Tipo: \"Motivo\" \n                }\n            )\n        );\n\n        ForAll(\n        colTrackingTicketsSpv As TrackingTicket,\n        \n            // 1. Si existe un comentario, crear una fila\n            If(Len(Trim(PlainText(TrackingTicket.Comentario))) > 0,\n                Collect(colDiscusionTicketSpv,\n                    {\n                        Image: TrackingTicket.'Creado por'.Picture, \n                        UserName: TrackingTicket.'Creado por'.DisplayName, \n                        FechaCreado: TrackingTicket.FechaModificado, \n                        Comentario: TrackingTicket.Comentario, // Usamos un nombre genérico para el texto\n                        Tipo: \"Comentario\"\n                    }\n                )\n            );\n\n            // 2. Si existe un motivo, crear otra fila independiente\n            If(Not(IsBlank(TrackingTicket.Motivo)),\n                Collect(colDiscusionTicketSpv,\n                    {\n                        Image: TrackingTicket.'Creado por'.Picture, \n                        UserName: TrackingTicket.'Creado por'.DisplayName, \n                        FechaCreado: TrackingTicket.FechaModificado, \n                        Comentario:$\"{If(IsBlank(TrackingTicket.Motivo),\"\",\"Motivo: \"&TrackingTicket.Motivo)}{\"</br>\"}{If(IsBlank(TrackingTicket.MotivoObservacion),\"\",\"Comentario: \"&TrackingTicket.MotivoObservacion)}\",\n                        Tipo: \"Motivo\" \n                    }\n                )\n            )\n        ),\n        \n        ForAll(\n            colTrackingTicketsSpv As TrackingTicket,\n            \n            // 1. Si existe un comentario, crear una fila\n            If(Len(Trim(PlainText(TrackingTicket.Comentario))) > 0,\n                Collect(colDiscusionTicketSpv,\n                    {\n                        Image: TrackingTicket.'Creado por'.Picture, \n                        UserName: TrackingTicket.'Creado por'.DisplayName, \n                        FechaCreado: TrackingTicket.FechaModificado, \n                        Comentario: TrackingTicket.Comentario, // Usamos un nombre genérico para el texto\n                        Tipo: \"Comentario\"\n                    }\n                )\n            );\n\n            // 2. Si existe un motivo, crear otra fila independiente\n            If(Not(IsBlank(TrackingTicket.Motivo)),\n                Collect(colDiscusionTicketSpv,\n                    {\n                        Image: TrackingTicket.'Creado por'.Picture, \n                        UserName: TrackingTicket.'Creado por'.DisplayName, \n                        FechaCreado: TrackingTicket.FechaModificado, \n                        Comentario:$\"{If(IsBlank(TrackingTicket.Motivo),\"\",\"Motivo: \"&TrackingTicket.Motivo)}{\"</br>\"}{If(IsBlank(TrackingTicket.MotivoObservacion),\"\",\"Comentario: \"&TrackingTicket.MotivoObservacion)}\",\n                        Tipo: \"Motivo\" \n                    }\n                )\n            )\n        )\n        ),\n        // concatenar estado Actual\n        If(Len(Trim(PlainText(Var_SpvTicketSeleccionada.Comentario))) > 0,\n            Collect(colDiscusionTicketSpv,\n                {\n                    Image: Var_SpvTicketTracking.Author.Picture, \n                    UserName: Var_SpvTicketTracking.Author.DisplayName, \n                    FechaCreado: Var_SpvTicketTracking.FechaModificado, \n                    Comentario: Var_SpvTicketSeleccionada.Comentario,\n                    Tipo: \"Comentario\"\n                }\n            )\n        );\n\n        // 2. Si existe un motivo, crear otra fila independiente\n        If(Not(IsBlank(Var_SpvTicketSeleccionada.Motivo)),\n            Collect(colDiscusionTicketSpv,\n                {\n                    Image: Var_SpvTicketTracking.Author.Picture, \n                    UserName: Var_SpvTicketTracking.Author.DisplayName, \n                    FechaCreado: Var_SpvTicketTracking.FechaModificado,\n                    Comentario:$\"{If(IsBlank(Var_SpvTicketSeleccionada.Motivo),\"\",\"Motivo: \"&Var_SpvTicketSeleccionada.Motivo)}{\"</br>\"}{If(IsBlank(Var_SpvTicketSeleccionada.MotivoObservacion),\"\",\"Comentario: \"&Var_SpvTicketSeleccionada.MotivoObservacion)}\",\n                    Tipo: \"Motivo\" \n                }\n            )\n        );\n\n        ForAll(\n        colTrackingTicketsSpv As TrackingTicket,\n        \n            // 1. Si existe un comentario, crear una fila\n            If(Len(Trim(PlainText(TrackingTicket.Comentario))) > 0,\n                Collect(colDiscusionTicketSpv,\n                    {\n                        Image: TrackingTicket.'Creado por'.Picture, \n                        UserName: TrackingTicket.'Creado por'.DisplayName, \n                        FechaCreado: TrackingTicket.FechaModificado, \n                        Comentario: TrackingTicket.Comentario, // Usamos un nombre genérico para el texto\n                        Tipo: \"Comentario\"\n                    }\n                )\n            );\n\n            // 2. Si existe un motivo, crear otra fila independiente\n            If(Not(IsBlank(TrackingTicket.Motivo)),\n                Collect(colDiscusionTicketSpv,\n                    {\n                        Image: TrackingTicket.'Creado por'.Picture, \n                        UserName: TrackingTicket.'Creado por'.DisplayName, \n                        FechaCreado: TrackingTicket.FechaModificado, \n                        Comentario:$\"{If(IsBlank(TrackingTicket.Motivo),\"\",\"Motivo: \"&TrackingTicket.Motivo)}{\"</br>\"}{If(IsBlank(TrackingTicket.MotivoObservacion),\"\",\"Comentario: \"&TrackingTicket.MotivoObservacion)}\",\n                        Tipo: \"Motivo\" \n                    }\n                )\n            )\n        )\n    )\n);\n\nUpdateContext({datosAdjuntos: 'LCP-001_Flow_ObtenerAdjuntos'.Run(Text(Var_SpvTicketSeleccionada.ID))});\nIf(\n    datosAdjuntos.response = \"200\",\n    Clear(colAdjuntosDetalleTicket);\n    ForAll(\n        Table(ParseJSON(datosAdjuntos.datosadjuntos)),\n        Collect(\n            colAdjuntosDetalleTicket,\n            {\n                Nombre: Text(ThisRecord.Value.Nombre),\n                PesoBytes: Value(ThisRecord.Value.PesoBytes),\n                Url: Text(ThisRecord.Value.Url),\n                TipoAdjunto: Text(ThisRecord.Value.TipoAdjunto)\n            }\n        )\n    );\n\nForAll(\n    Filter(colTrackingTicketsSpv, Or(Not(IsBlank(LimitePermitidoURL)))),\n    Collect(colAdjuntosDetalleTicket,\n    {  \n        Nombre: \"URL Elemento\", \n        PesoBytes: 0, \n        Url: Text(ThisRecord.LimitePermitidoURL),\n        TipoAdjunto: \"TipoURL\"\n    }\n    )\n)\n);\nSet(\n    varBytesExistentes,\n    Sum(\n        colAdjuntosDetalleTicket,\n        PesoBytes\n    )\n);\nClearCollect(colCambiosTicketSpv, colTrackingTicketsSpv);\n\n// 1. Creamos la colección ordenada y con estados únicos (Distinct)\nClearCollect(\n    colEstadosRecorridos,\n    Distinct(\n        Sort(colCambiosTicketSpv, Creado, SortOrder.Ascending), // *Nota: Cambia 'Fecha' por el nombre real de tu columna de fecha\n        EstadoActual\n    )\n);\n// 2. NUEVO: Detectamos cuál es el último estado registrado (Estado Actual)\nSet(\n    Var_EstadoActualTicket,\n    Last(Sort(colCambiosTicketSpv, Creado, SortOrder.Ascending)).EstadoActual\n);\n// 2. Traducimos tu fórmula de ColorFade a un Hex dinámico para que el SVG lo entienda perfectamente\nSet(\n    Var_ColorGrayFadeHex, \n    \"#F5F5F5\"\n);\n\nClearCollect(\n    colTransicionEstadoSpv,\n    Filter(\n        Switch(\n            Text(Var_SpvTicketSeleccionada.Estado),\n            \n            // Caso switch 1: En Revisión\n            Var_EstadosApp.EstadoEnRevision,\n            Table(\n                { Value: If(Var_MatrizAccesosApp.AtencionTicket, Var_EstadosApp.EstadoEnProceso, Blank()) },\n                { Value: If(Var_MatrizAccesosApp.ObservarTicket, Var_EstadosApp.EstadoObservado, Blank()) }, // el camino para observar ticket\n                { Value: If(Var_MatrizAccesosApp.DerivarTicket, Var_EstadosApp.EstadoDerivado, Blank()) }\n            ),\n\n            // Caso switch 2: Cerrado\n            Var_EstadosApp.EstadoCerrado,\n            Table({ Value: \"\" }),\n\n            // Caso switch 3: En Proceso\n            Var_EstadosApp.EstadoEnProceso,\n            Table(\n                { Value: If(Var_MatrizAccesosApp.AtencionTicket, Var_EstadosApp.EstadoResuelto, Blank()) },\n                { Value: If(Var_MatrizAccesosApp.SolicitarAprobacionTicket, Var_EstadosApp.EstadoEnEsperaAprobacion, Blank()) },\n                // agregar el camino para observar el ticket\n                //12/06/2026\n                { Value: If(Var_MatrizAccesosApp.RechazarTicket, Var_EstadosApp.EstadoRechazado, Blank()) },\n                { Value: If(Var_MatrizAccesosApp.ObservarTicket, Var_EstadosApp.EstadoObservado, Blank()) }\n                    \n            ),\n\n            // Caso switch 4: Rechazado\n            Var_EstadosApp.EstadoRechazado,\n            Table({ Value: \"\" }),\n\n            // Caso switch 5: Observado\n            Var_EstadosApp.EstadoObservado,\n            If(Var_MatrizAccesosApp.SubsanaTicket, Table({ Value: Var_EstadosApp.EstadoEnRevision }), Table({ Value: Blank() })),\n\n            // Caso switch 6: En Espera Aprobación\n            Var_EstadosApp.EstadoEnEsperaAprobacion,\n            Table({ Value: If(Var_MatrizAccesosApp.AtencionTicket, Var_EstadosApp.EstadoResuelto, Blank()) }), \n            // tengo entendido que esta etapa no aplica porque se habilitan 2 botones para aprobar o rechazar? Var_EstadosApp.EstadoEnProceso\n\n            // Caso switch 7: Resuelto\n            Var_EstadosApp.EstadoResuelto,\n            Table({ Value: \"\" }), \n            // esto no aplica porque se tiene una opción del solicitante para cerrar el ticket Var_EstadosApp.EstadoCerrado\n\n            // Caso switch 8: Derivado\n            Var_EstadosApp.EstadoDerivado,\n            Table({ Value: \"\" })\n        ),\n        // AQUÍ ESTÁ EL TRUCO: Filtramos para que no pasen los vacíos ni los registros en blanco\n        !IsBlank(Value) && Value <> \"\"\n    )\n);\n\n\n\n\n//===CAMBIOS CC2 UNIFICACION===\n\n\n/*\nSwitch(Var_RolSistema;\n    Var_RolApp.RolSupervisor;\n        ClearCollect(colTransicionEstadoSpv;\n            Switch(\n                Text(Var_SpvTicketSeleccionada.Estado);\n                //Caso switch 1\n                Var_EstadosApp.EstadoEnRevision;\n                    [Var_EstadosApp.EstadoEnProceso; Var_EstadosApp.EstadoObservado; Var_EstadosApp.EstadoDerivado];\n                //Caso switch 2\n                Var_EstadosApp.EstadoCerrado;\n                    [\"\"];\n                //Caso switch 3\n                Var_EstadosApp.EstadoEnProceso;\n                    [Var_EstadosApp.EstadoResuelto; Var_EstadosApp.EstadoEnEsperaAprobacion];\n                //Caso switch 4\n                Var_EstadosApp.EstadoRechazado;\n                    [\"\"];\n                //Caso switch 5\n                Var_EstadosApp.EstadoObservado;\n                    [Var_EstadosApp.EstadoEnRevision];\n                //Caso switch 6\n                Var_EstadosApp.EstadoEnEsperaAprobacion;\n                    [Var_EstadosApp.EstadoEnProceso];\n                //Caso switch 7\n                Var_EstadosApp.EstadoResuelto;\n                    [Var_EstadosApp.EstadoCerrado];\n                //Caso switch 8\n                Var_EstadosApp.EstadoDerivado;\n                    [\"\"]\n            )\n        );\n    Var_RolApp.RolAnalista;\n        ClearCollect(colTransicionEstadoSpv;\n            Switch(\n                Text(Var_SpvTicketSeleccionada.Estado);\n                //Caso switch 1\n                Var_EstadosApp.EstadoEnRevision;\n                    [Var_EstadosApp.EstadoEnProceso; Var_EstadosApp.EstadoObservado; Var_EstadosApp.EstadoDerivado];\n                //Caso switch 2\n                Var_EstadosApp.EstadoCerrado;\n                    [\"\"];\n                //Caso switch 3\n                Var_EstadosApp.EstadoEnProceso;\n                    [Var_EstadosApp.EstadoResuelto; Var_EstadosApp.EstadoEnEsperaAprobacion];\n                //Caso switch 4\n                Var_EstadosApp.EstadoRechazado;\n                    [\"\"];\n                //Caso switch 5\n                Var_EstadosApp.EstadoObservado;\n                    [Var_EstadosApp.EstadoEnRevision];\n                //Caso switch 6\n                Var_EstadosApp.EstadoEnEsperaAprobacion;\n                    [Var_EstadosApp.EstadoResuelto];\n                //Caso switch 7\n                Var_EstadosApp.EstadoResuelto;\n                    [\"\"];//Var_EstadosApp.EstadoCerrado\n                //Caso switch 8\n                Var_EstadosApp.EstadoDerivado;\n                    [\"\"]\n            )\n    );\n    Var_RolApp.RolSolicitante;\n    ClearCollect(colTransicionEstadoSpv;\n            Switch(\n                Text(Var_SpvTicketSeleccionada.Estado);\n                //Caso switch 1\n                Var_EstadosApp.EstadoEnRevision;\n                    [Var_EstadosApp.EstadoEnProceso; Var_EstadosApp.EstadoObservado; Var_EstadosApp.EstadoDerivado];\n                //Caso switch 2\n                Var_EstadosApp.EstadoCerrado;\n                    [\"\"];\n                //Caso switch 3\n                Var_EstadosApp.EstadoEnProceso;\n                    [Var_EstadosApp.EstadoResuelto; Var_EstadosApp.EstadoEnEsperaAprobacion];\n                //Caso switch 4\n                Var_EstadosApp.EstadoRechazado;\n                    [\"\"];\n                //Caso switch 5\n                Var_EstadosApp.EstadoObservado;\n                    [Var_EstadosApp.EstadoEnRevision; Var_EstadosApp.EstadoCerrado];\n                //Caso switch 6\n                Var_EstadosApp.EstadoEnEsperaAprobacion;\n                    [Var_EstadosApp.EstadoEnProceso];\n                //Caso switch 7\n                Var_EstadosApp.EstadoResuelto;\n                    [Var_EstadosApp.EstadoCerrado];\n                //Caso switch 8\n                Var_EstadosApp.EstadoDerivado;\n                    [\"\"]\n            )\n        )\n);;\n//============================================\n*/\n\n\nUpdateContext({\n    Var_Ctx_ConfiguracionPaisSociedad: LookUp(\n        'LCP-001_List_Configuracion_Ticket',\n        Codigo = Text(Var_SpvTicketSeleccionada.ConfiguracionTicket),\n        CabeceraPaisSociedad\n        )\n});\n\nClear(Col_ConfiguracionTablaSpv);\nForAll(\n    Table(ParseJSON(Var_Ctx_ConfiguracionPaisSociedad)),\n    Collect(\n        Col_ConfiguracionTablaSpv,\n        {\n            Etiqueta: Text(ThisRecord.Value.Etiqueta),\n            Obligatorio: Boolean(ThisRecord.Value.Obligatorio)\n        }\n    )\n);\n\nUpdateContext(\n    {\n        Var_Ctx_PaisObligatorio: LookUp(Col_ConfiguracionTablaSpv, ThisRecord.Etiqueta = \"País\", ThisRecord.Obligatorio),\n        Var_Ctx_SociedadObligatorio: LookUp(Col_ConfiguracionTablaSpv, ThisRecord.Etiqueta = \"Sociedad\", ThisRecord.Obligatorio)\n    }\n);\n\nClearCollect(colUpdateGerenciaSpv,  RenameColumns(ShowColumns(col_gblGerencia, Nombre), Nombre, Value));\n\nUpdateContext({varGerenciaSelected: {Value: Text(Var_SpvTicketSeleccionada.Gerencia)}});\nUpdateContext({varUpdateAreaSelected: {Area: Text(Var_SpvTicketSeleccionada.Area)}});\nUpdateContext({varUpdateSubAreaSelected: {SubArea: Text(Var_SpvTicketSeleccionada.SubArea)}});\nUpdateContext(\n    {\n        varUpdateAtendidoPorSelected:\n        {\n            Nombre: Text(Var_SpvTicketSeleccionada.NombreAtendidoPor),\n            Correo: Text(Var_SpvTicketSeleccionada.CorreoAtendidoPor)\n        }\n    }\n);\nUpdateContext({varUpdateAnteriorNombreAtendidoPorSelected: {NombreAnterior: Text(Var_SpvTicketSeleccionada.AnalistaNombre)}});\nUpdateContext({varUpdateAnteriorCorreoAtendidoPorSelected: {CorreoAnterior: Text(Var_SpvTicketSeleccionada.AnalistaCorreo)}});\n\nClearCollect(\n    colUpdateAreaSpv,\n    Filter('LCP-001_List_GerenciaArea', Gerencia = Text(Var_SpvTicketSeleccionada.Gerencia) && Area = Text(Var_SpvTicketSeleccionada.Area)).Area\n);\nClearCollect(\n    colAreaSubAreaLocalSpv,\n    'LCP-001_List_AreaSubArea'\n);\nClearCollect(\n    colUpdateSubAreaSpv,\n    Filter(\n        colAreaSubAreaLocalSpv,\n        Area in colUpdateAreaSpv.Area\n    ).SubArea\n);\nUpdateContext({varUpdatePaisSelected: {Value: Text(Var_SpvTicketSeleccionada.Pais)}});\nUpdateContext({varUpdateSociedadSelected: {Sociedad: Text(Var_SpvTicketSeleccionada.Sociedad)}});\nClearCollect(\n    colPaisSociedadLocalSpv,\n    'LCP-001_List_PaisSociedad'\n);\nIf(\n    Text(Var_SpvTicketSeleccionada.SubArea) in [\n        \"Nóminas Perú\",\n        \"Nóminas Países\"\n    ],\n    ClearCollect(\n        colUpdatePaisSpv,\n        Filter(\n            'LCP-001_List_PaisSubArea',\n            SubArea = Text(Var_SpvTicketSeleccionada.SubArea)\n        ).Pais\n    );\n    ClearCollect(\n        colUpdateSociedadSpv,\n        Filter(\n            colPaisSociedadLocalSpv,\n            Pais in colUpdatePaisSpv.Pais\n        ).Sociedad\n    ),\n    ClearCollect(\n        colUpdatePaisSpv,\n        Distinct(\n            colPaisSociedadLocalSpv,\n            Pais\n        )\n    );\n);\nIf(\n    LookUp(\n        'LCP-001_List_Usuarios',\n        CorreoUsuario = varUpdateAtendidoPorSelected.Correo,\n        Estado\n    ) = \"Activo\",\n    Set(\n        VarReactivacion,\n        true\n    ),\n    Set(\n        VarReactivacion,\n        false\n    )\n);\n// 1. Evaluación defensiva del estado del Ticket y la cadena JSON\nIf(\n    !IsBlank(Var_SpvTicketSeleccionada) And \n    !IsBlank(Var_SpvTicketSeleccionada.AprobadoresCheck) And \n    Len(Trim(Text(Var_SpvTicketSeleccionada.AprobadoresCheck))) > 2, // > 2 previene cadenas vacías o corchetes sin datos '[]'\n    \n    // 2. Ejecución segura del ParseJSON si la evaluación es verdadera\n    ClearCollect(\n        colAprobadoresCheck,\n        AddColumns(\n            ForAll(\n                Table(ParseJSON(Trim(Var_SpvTicketSeleccionada.AprobadoresCheck))),\n                {\n                    correo: Text(ThisRecord.Value.correo),\n                    nombre: Text(ThisRecord.Value.nombre),\n                    estado: Text(ThisRecord.Value.estado),\n                    fecha: Text(ThisRecord.Value.fecha)\n                }\n            ),\n            FechaOrden,\n            // Convertimos el texto a DateTime asumiendo un formato de fecha local.\n            If(IsBlank(fecha) Or Len(fecha) < 8, Blank(), DateTimeValue(fecha, \"es-ES\"))\n        )\n    ),\n    \n    // 3. Fallback: Si no hay ticket o el JSON viene vacío, se limpia la colección.\n    // Esto asegura que la UI no colapse ni muestre datos fantasma.\n    Clear(colAprobadoresCheck)\n);\n\n//Resetea Variables de la seccion propiedades\nSelect(btn_ocultoLimpiarPropiedades);"
