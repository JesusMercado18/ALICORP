                Properties:
                  CerrarModal: |-
                    =Reset(Gbl_App_Confirmation_Update_3);
                    UpdateContext({ Var_Ctx_ModalConfirmacion: false });
                    UpdateContext({Var_Ctx_OperacionCatalogo: false})
                  DescripcionMotivo: ="Texto"
                  Guardar: "=// 1. VALIDACIONES INICIALES\r\nRefresh('LCP-001_List_TicketSolicitudes');\r\n\r\nIf(\r\n    And(\r\n    Self.ValorMotivo = \"Otro\",\r\n    IsBlank(Trim(Self.ValorOtro))\r\n    )\r\n    , \r\n    UpdateContext(\r\n    {\r\n        CloseAlert: true,\r\n        Mensaje:\"Se debe ingresar la descripcion del motivo.\"\r\n    }\r\n    ),\r\n    IsBlank(Self.ValorMotivo),\r\n    UpdateContext(\r\n    {\r\n            CloseAlert: true,\r\n            Mensaje: \"Debes seleccionar el motivo\" \r\n\r\n    }\r\n    ),\r\n    //Terminan las validaciones\r\n    \r\n// 2. SI LAS VALIDACIONES PASAN, PROCEDEMOS \r\n\r\n    IfError(\r\n    If( \r\n        Var_Ctx_AccionEstado = Var_EstadosApp.EstadoRechazado,\r\n        //---->\r\n        //Notify( \"Entra al caso de rechazo correcto\");;\r\n        //Se ejecuta el codigo del boton que encapsula la logica de los Patch de los cambios de estados del ticket\r\n        //Por sincronia\r\n\r\n        UDFEstadoRechazado(\r\n            Var_Ctx_OperacionCatalogo,\r\n            false,\r\n            Self.ValorMotivo,\r\n            Self.ValorOtro,\r\n            Spv_RichComentariosDetalleTicket_1.HtmlText,\r\n            Gbl_Spv_AttachmentDetalleTicket_1.URL,\r\n            \"\",\r\n            \"\"\r\n        );\r\n        UpdateContext({Var_CTX_ResultadoModal: true}),\r\n\r\n        Var_Ctx_AccionEstado = Var_EstadosApp.EstadoObservado,\r\n        \r\n        UDFObtenerDatosUsuarioDestino(Var_SpvTicketSeleccionada.CorreoAtendidoPor);\r\n        //Se comprueba si el usuario ha establecido un SLA personalizado si se ha establecido se asigna ese SLA, caso contrario el SLA queda con el resultado asignado en la UDFCalcularSLAEstado\r\n        If(Value(Spv_TxtAsignarSLATiempoAtencionDetalleTicket_1.Text)<>0, \r\n        Set(GVar_SLACalculado,Value(Spv_TxtAsignarSLATiempoAtencionDetalleTicket_1.Text)),\r\n        UDFCalcularSLAEstado(Var_EstadosApp.EstadoObservado)\r\n        );\r\n        UDFEstadoObservado(  \r\n            true,\r\n            Self.ValorMotivo,\r\n            Self.ValorOtro,\r\n            Spv_RichComentariosDetalleTicket_1.HtmlText,\r\n            Gbl_Spv_AttachmentDetalleTicket_1.URL\r\n        );\r\n        UpdateContext({ Var_CTX_ResultadoModal: true }),\r\n        \r\n        //Si se esta realizando unicamente una solicitud de reacitivacion\r\n        And( Var_Ctx_AccionEstado = Var_EstadosApp.EstadoReactivado, Var_Ctx_SolicitarReactivar),\r\n        UDFObtenerDatosUsuarioDestino(Var_SpvTicketSeleccionada.CorreoAtendidoPor);\r\n        UDFEstadoReactivado(\r\n            false,//-> true para realizar la reactivar\r\n            true,//-> true cuan unicamente es una solicitud de reactivacion\r\n            true,//-> Si el modal con seleccion ha sido abierto\r\n            Self.ValorMotivo,\r\n            Self.ValorOtro,\r\n            Spv_RichComentariosDetalleTicket_1.HtmlText,\r\n            Gbl_Spv_AttachmentDetalleTicket_1.URL\r\n        );\r\n        UpdateContext({ Var_CTX_ResultadoModal: true }),\r\n        \r\n        //Caso Derivacion\r\n        Var_Ctx_AccionEstado = Var_EstadosApp.EstadoDerivado,\r\n        //---->\r\n        //Notify(\"CASO CORRECTO DERIVADO\");;\r\n        If(\r\n        !IsBlank(varUpdateAtendidoPorSelected.Correo),\r\n        UDFObtenerDatosUsuarioDestino(Var_SpvTicketSeleccionada.CorreoAtendidoPor);\r\n        UDFCalcularSLAEstado(Var_EstadosApp.EstadoEnRevision)\r\n        );\r\n        \r\n        UDFEstadoDerivado(\r\n            true,//-> Si el modal con seleccion ha sido abierto\r\n            Self.ValorMotivo,\r\n            Self.ValorOtro,\r\n            Spv_RichComentariosDetalleTicket_1.HtmlText,\r\n            Gbl_Spv_AttachmentDetalleTicket_1.URL,\r\n            Sol_Cbx_AtendidoPor_6.Selected.Correo,\r\n            Sol_Cbx_AtendidoPor_6.Selected.Nombre,\r\n            Var_SpvTicketSeleccionada.CorreoAtendidoPor,\r\n            Var_SpvTicketSeleccionada.NombreAtendidoPor,\r\n            Sol_Cbx_Gerencia_1.Selected.Value,\r\n            Sol_Cbx_Area_2.Selected.Area,\r\n            Sol_Cbx_SubArea_3.Selected.SubArea,\r\n            Sol_Cbx_Pais_4.Selected.Value,\r\n            Sol_Cbx_Sociedad_5.Selected.Sociedad,\r\n            Sol_Cbx_NivelConfidencialidad.Selected.Value,\r\n            Not(Var_SpvTicketSeleccionada.NivelDeConfidencialidad = Sol_Cbx_NivelConfidencialidad.Selected.Value)\r\n        );\r\n        UpdateContext({ Var_CTX_ResultadoModal: true }),\r\n        Var_Ctx_AccionEstado = \"Reasignar\",\r\n        UDFObtenerDatosUsuarioDestino(Sol_Cbx_AtendidoPor_6.Selected.Correo);\r\n        UDFCalcularSLAEstado(Var_EstadosApp.EstadoEnRevision);\r\n        \r\n        UDFReasignar(\r\n            true,//-> Si el modal con seleccion ha sido abierto\r\n            Self.ValorMotivo,\r\n            Self.ValorOtro,\r\n            Spv_RichComentariosDetalleTicket_1.HtmlText,\r\n            Gbl_Spv_AttachmentDetalleTicket_1.URL,\r\n            Sol_Cbx_AtendidoPor_6.Selected.Correo,\r\n            Sol_Cbx_AtendidoPor_6.Selected.Nombre,\r\n            Var_SpvTicketSeleccionada.CorreoAtendidoPor,\r\n            Var_SpvTicketSeleccionada.NombreAtendidoPor,\r\n            Sol_Cbx_Gerencia_1.Selected.Value,\r\n            Sol_Cbx_Area_2.Selected.Area,\r\n            Sol_Cbx_SubArea_3.Selected.SubArea,\r\n            Sol_Cbx_Pais_4.Selected.Value,\r\n            Sol_Cbx_Sociedad_5.Selected.Sociedad,\r\n            Sol_Cbx_NivelConfidencialidad.Selected.Value,\r\n            Not(Var_SpvTicketSeleccionada.NivelDeConfidencialidad = Sol_Cbx_NivelConfidencialidad.Selected.Value)\r\n        );\r\n        UpdateContext({ Var_CTX_ResultadoModal: true }),\r\n        Var_Ctx_AccionEstado = Var_EstadosApp.EstadoCerrado,\r\n\r\n        UDFEstadoCerrado(\r\n                true,\r\n                false,\r\n                Self.ValorMotivo,\r\n            Self.ValorOtro,\r\n               Spv_RichComentariosDetalleTicket_1.HtmlText,\r\n            Gbl_Spv_AttachmentDetalleTicket_1.URL,\r\n  