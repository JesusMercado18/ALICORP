                                                      OnSelect: "=// Se calcula el valor que toma el SLA del estado\n// Se calcula mediante una UDF \n// Fin del sla \n\n    Refresh('LCP-001_List_TicketSolicitudes');\n    \n    If(\n    And(\n    Var_SpvTicketSeleccionada.Estado = Var_EstadosApp.EstadoCerrado,\n    Spv_ClasCalificacionDetalleTicket_1.Value = 0\n    ),\n    UpdateContext({CloseAlert: true, Mensaje: \"Debes calificar el ticket.\"}),\n    //Se agrega linea ya que se estaba ejecutando en cualquier estado pero solo aplica para EstadoCerrado\n\n    // Calificación del ticket\n    Var_SpvTicketSeleccionada.Estado = Var_EstadosApp.EstadoCerrado,\n                    IfError(\n                    UDFObtenerDatosUsuarioDestino(Var_SpvTicketSeleccionada.CorreoAtendidoPor);\n                    Notify(\"Procesar estado\");\n                    //UDFCalcularSLAEstado(Var_SpvTicketSeleccionada.ConfiguracionTicket;Var_EstadosApp.EstadoEnRevision);;\n                    UDFEstadoCerrado(\n                    false,\n                    false,\n                    \"\",\n                    \"\",\n                    Spv_RichComentariosDetalleTicket_1.HtmlText,\n                    Gbl_Spv_AttachmentDetalleTicket_1.URL,\n                    // Estado del responsable activo/inactivo\n                    If(GDatoUsuario.Estado = \"Activo\",Var_SpvTicketSeleccionada.CorreoAtendidoPor,Blank()),\n                    If(GDatoUsuario.Estado = \"Activo\",Var_SpvTicketSeleccionada.NombreAtendidoPor,Blank()),\n                    0\n                    ),\n                    Set(\n                            _varError,\n                            {\n                                Fecha: Now(),\n                                Usuario: {\n                                    Codigo: Var_ProfileUser.Codigo,\n                                    Nombre: Var_ProfileUser.NombreApellido\n                                },\n                                CodigoTicket: Var_SpvTicket