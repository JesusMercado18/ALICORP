Reset(Gbl_Spv_AttachmentDetalleTicket_1); \r\n        If(\r\n        Var_Ctx_AccionEstado  = Var_EstadosApp.EstadoReactivado,\r\n        \r\n        Navigate(\r\n            Gbl_Ticket,\r\n            ScreenTransition.Fade,\r\n            {\r\n                AlertaSatisfactoria: true,\r\n                MensajeSatisfactorio: \"Se ha enviado la solicitud de reactivación.\"\r\n            }\r\n        )\r\n        ,    \r\n        \r\n        Navigate(\r\n            Gbl_Ticket,\r\n            ScreenTransition.Fade,\r\n            {\r\n                AlertaSatisfactoria: true,\r\n                MensajeSatisfactorio: \"Se actualizó el estado del ticket.\"\r\n            }\r\n        )\r\n        )\r\n        )\r\n    )\r\n\r\n)\r\n\r\n//============================================\r\n/*\r\n//===CAMBIOS CC2 UNIFICACION===\r\n\r\nSwitch(\r\nVar_RolSistema;\r\n//===SWITCH ROL SUPERVISOR===\r\n   Var_RolApp.RolSupervisor;\r\n//SUPERVISOR\r\n\r\n// 1. VALIDACIONES INICIALES\r\nIf(\r\n    (Gbl_App_Confirmation_Update_3.ValorMotivo = \"Otro\" && IsBlank(Trim(Gbl_App_Confirmation_Update_3.ValorOtro))) || IsBlank(Gbl_App_Confirmation_Update_3.ValorMotivo);\r\n    \r\n    UpdateContext({\r\n        CloseAlert: true;\r\n        Mensaje: If(IsBlank(Gbl_App_Confirmation_Update_3.ValorMotivo); \"Debes seleccionar el motivo\"; \"Debes ingresar el motivo.\")\r\n    });\r\n    //Si el boton Var_Ctx_BtnReasignar es true se hace la logica que estaba en el boton, de caso contrario se hacen los demas casos\r\n    If(Var_Ctx_BtnReasignar;\r\n    //Logica If true\r\n            If(\r\n            IsBlank(varGerenciaSelected.Value);\r\n                UpdateContext({ CloseAlert: true; Mensaje: \"Debes ingresar la Gerencia.\" });\r\n        \r\n            IsBlank(varUpdateAreaSelected.Area);\r\n                UpdateContext({ CloseAlert: true; Mensaje: \"Debes ingresar el Área.\" });\r\n        \r\n            IsBlank(varUpdateSubAreaSelected.SubArea);\r\n                UpdateContext({ CloseAlert: true; Mensaje: \"Debes ingresar la SubÁrea.\" });\r\n        \r\n            Var_Ctx_PaisObligatorio && IsBlank(varUpdatePaisSelected.Value);\r\n                UpdateContext({ CloseAlert: true; Mensaje: \"Debes ingresar el País.\" });\r\n        \r\n            Var_Ctx_SociedadObligatorio && IsBlank(varUpdateSociedadSelected.Sociedad);\r\n                UpdateContext({ CloseAlert: true; Mensaje: \"Debes ingresar la Sociedad.\" });\r\n            \r\n            !(Spv_LblEstadoActualDetalleTicket_1.Text in [Var_EstadosApp.EstadoEnRevision; Var_EstadosApp.EstadoDerivado; Var_EstadosApp.EstadoObservado; Var_EstadosApp.EstadoEnProceso; Var_EstadosApp.EstadoEnEsperaAprobacion]);\r\n                UpdateContext({ CloseAlert: true; Mensaje: \"El estado actual (\" & Spv_LblEstadoActualDetalleTicket_1.Text & \") no permite actualizar el ticket.\" });\r\n        \r\n            IfError(\r\n            \r\n                Patch(\r\n                    'LCP-001_List_TicketSolicitudes';\r\n                    { ID: Value(Var_SpvTicketSeleccionada.ID) };\r\n                    {\r\n                        Gerencia: varGerenciaSelected.Value;\r\n                        Area: varUpdateAreaSelected.Area;\r\n                        SubArea: varUpdateSubAreaSelected.SubArea;\r\n                        Pais: varUpdatePaisSelected.Value;\r\n                        Sociedad: varUpdateSociedadSelected.Sociedad;\r\n                        AnalistaNombre: varUpdateAtendidoPorSelected.Nombre;\r\n                        AnalistaCorreo: varUpdateAtendidoPorSelected.Correo;\r\n                        FechaModificado: Now();\r\n                        ReAsignado: true;\r\n                        LimitePermitidoURL: Gbl_Spv_AttachmentDetalleTicket_1.URL;\r\n                        Motivo: Gbl_App_Confirmation_Update_3.ValorMotivo;\r\n                        MotivoObservacion: Gbl_App_Confirmation_Update_3.ValorOtro;\r\n                        // No pasar comentarios con espacios en blanco\r\n                        Comentario: Spv_RichComentariosDetalleTicket_1.HtmlText;\r\n                        Accionador: Var_RolSistema;\r\n                        // Nuevo Analista\r\n                        NombreAtendidoPor: varUpdateAtendidoPorSelected.Nombre;\r\n                        CorreoAtendidoPor: varUpdateAtendidoPorSelected.Correo;\r\n                        // Analista anterior\r\n                        AtendidoNombreAnterior: Var_SpvTicketSeleccionada.NombreAtendidoPor;\r\n                        AtendidoCorreoAnterior: Var_SpvTicketSeleccionada.CorreoAtendidoPor;\r\n                        Derivado: false;\r\n                        Rechazado: false;\r\n                        VistoBueno: false;\r\n                        VariosAprobadores: false;\r\n                        Aprobacion: false;\r\n                        ReApertura: false;\r\n                        SolSubsanado: false\r\n                    }\r\n                );\r\n        \r\n                UpdateContext({\r\n                    CloseAlert: true;\r\n                    Mensaje: \"Ocurrió un error al actualizar el ticket.\"\r\n                });\r\n                UpdateContext({Var_Ctx_ModalConfirmacion: false});;\r\n                //UpdateContext({\r\n                //    AlertaSatisfactoria: true;\r\n                //    MensajeSatisfactorio: \"Se actualizó las propiedades del ticket.\"\r\n                //})\r\n                Navigate(\r\n                    Gbl_Ticket;\r\n                    ScreenTransition.Fade;\r\n                    {\r\n                        AlertaSatisfactoria: true;\r\n                        MensajeSatisfactorio: \"Se reasigno el ticket correctamente.\"\r\n                    }\r\n                )\r\n            )\r\n        );\r\n    //Logica If false\r\n    Switch(Var_SpvTicketSeleccionada.Estado;\r\n    //================CASO 1==================================\r\n        Var_EstadosApp.EstadoEnEsperaAprobacion;\r\n            // 1. Creación de la colección con columna tipada para ordenamiento cronológico\r\n            ClearCollect(\r\n                colAprobadoresCheck;\r\n                AddColumns(\r\n                    ForAll(\r\n                        Table(ParseJSON(Trim(Var_SpvTicketSeleccionada.AprobadoresCheck)));\r\n                        {\r\n                            correo: Text(ThisRecord.Value.correo);\r\n                            nombre: Text(ThisRecord.Value.nombre);\r\n                            estado: Text(ThisRecord.Value.estado);\r\n                            fecha: Text(ThisRecord.Value.fecha)\r\n                        }\r\n                    );\r\n                    FechaOrden;\r\n                    If(IsBlank(fecha) Or Len(fecha) < 8; Blank(); DateTimeValue(fecha; \"es-ES\"))\r\n                )\r\n            );;\r\n            // 2. Aislamiento del registro y actualización estructurada\r\n            With(\r\n                {\r\n                    varTargetRecord: First(\r\n                        Sort(\r\n                            Filter(\r\n                                colAprobadoresCheck;\r\n                                correo = Var_ProfileUser.CorreoUsuario && IsBlank(estado)\r\n                            );\r\n                            FechaOrden;\r\n                            SortOrder.Descending\r\n                        )\r\n                    )\r\n                };\r\n                // 3. Verificamos que el registro haya sido encontrado antes de aplicar Patch\r\n                If(\r\n                    !IsBlank(varTargetRecord.correo);\r\n                    Patch(\r\n                        colAprobadoresCheck;\r\n                        varTargetRecord;\r\n                        {\r\n                            estado: \"Rechazado\";\r\n                            fecha: Text(Now(); \"dd/mm/yyyy hh:mm:ss\")\r\n                        }\r\n                    )\r\n                )\r\n            );;\r\n            // 1. SI LAS VALIDACIONES PASAN, PROCEDEMOS \r\n            IfError(\r\n                Switch(Var_Ctx_AccionEstado;\r\n                    //Caso switch 1\r\n                    Var_EstadosApp.EstadoRechazado;\r\n                    Patch(\r\n                        'LCP-001_List_TicketSolicitudes';\r\n                        LookUp('LCP-001_List_TicketSolicitudes';ID = Var_SpvTicketSeleccionada.ID);\r\n                        {\r\n                            EstadoActual: Var_EstadosApp.EstadoEnProceso;\r\n                            LimitePermitidoURL: Gbl_Spv_AttachmentDetalleTicket_1.URL;\r\n                            Motivo: Gbl_App_Confirmation_Update_3.ValorMotivo;\r\n                            MotivoObservacion: Gbl_App_Confirmation_Update_3.ValorOtro;\r\n                            Comentario: Spv_RichComentariosDetalleTicket_1.HtmlText;\r\n                            FechaModificado: Now();\r\n                            Accionador: Var_RolSistema;\r\n                            Evento: Var_EventoTrazabilidadApp.Estado;\r\n                            AprobadoresCheck: JSON(colAprobadoresCheck;JSONFormat.Compact);\r\n                            Derivado: false;\r\n                            Rechazado: false;\r\n                            VistoBueno: false;\r\n                            VariosAprobadores: false;\r\n                            //Aprobacion: true; //Se deja comentado porque la aprobacion viene del analista\r\n                            ReAsignado: false;\r\n                            ReApertura: false;\r\n                            SolSubsanado: false\r\n                        }\r\n                    );\r\n                    //Caso switch 2\r\n                    Var_EstadosApp.EstadoDerivado;\r\n                    Patch(\r\n                        'LCP-001_List_TicketSolicitudes';\r\n                        LookUp('LCP-001_List_TicketSolicitudes';ID = Var_SpvTicketSeleccionada.ID);\r\n                        {\r\n                   