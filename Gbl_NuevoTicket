                                    OnSelect: "=// 1. RESETEO Y MARCADO DE ERRORES DINÁMICOS\r\n\r\nUpdateContext( { Var_CmcLoadingSpinnerVisibleEnviar: true });\r\n\r\nUpdateContext({ varShowErrors: true });\r\n\r\n// 1. Recorremos toda la colección del formulario dinámico\r\nForAll(\r\n    colFormularioDinamicoNuevoTicket As FilaFormulario,\r\n    \r\n    // 2. Buscamos y extraemos en una tabla temporal todos los 'Value' que coincidan con el ID de la fila\r\n    With(\r\n        {\r\n            _valoresAux: Filter(colDatosAuxiliares, ID_Fila = FilaFormulario.ID).Value\r\n        },\r\n        \r\n        // 3. Si se encontraron valores en la colección auxiliar, actualizamos el registro\r\n        If(\r\n            !IsEmpty(_valoresAux),\r\n            Patch(\r\n                colFormularioDinamicoNuevoTicket,\r\n                FilaFormulario,\r\n                {\r\n                    // Concat junta todos los elementos de la tabla usando el separador \";\"\r\n                    ValorSeleccionad: Concat(_valoresAux, Value, \";\")\r\n                }\r\n            ),\r\n            \r\n            // 4. Si el usuario deseleccionó todo y no hay nada en colDatosAuxiliares, limpiamos el campo\r\n            Patch(\r\n                colFormularioDinamicoNuevoTicket,\r\n                FilaFormulario,\r\n                {\r\n                    ValorSeleccionad: Blank()\r\n                }\r\n            )\r\n        )\r\n    )\r\n);\r\n\r\n// colFormularioDinamicoNuevoTicket\r\n// colFormularioDinamicoNuevoTicket\r\n\r\nUpdateIf(colFormularioDinamicoNuevoTicket, true, { HasError: false });\r\n// revisa codigo porque cuando el usuario escoge opciones en el catalogo y su hijo es obligatorio pero solo debe cumplirse cuando haga match con el campo requerido\r\n\r\nUpdateIf(\r\n    colFormularioDinamicoNuevoTicket As Campo,\r\n    // REGLA 1: Solo evaluamos campos marcados como \"Requerido\"\r\n    Campo.Configuracion = \"Requerido\" && \r\n    (\r\n        // REGLA 2: El campo debe ser validado SI es un campo base O SI es un hijo cuya condición se cumple\r\n        IsBlank(Campo.DependeDe) || \r\n        With({ _Padre: LookUp(colFormularioDinamicoNuevoTicket, Label = Campo.DependeDe) },\r\n            If(IsBlank(_Padre), \r\n                false, // Si el padre no existe, el hijo no debería ser requerido\r\n                \r\n                // Lógica de evaluación de la condición del hijo respecto al valor del padre\r\n                With({ \r\n                    _valPadre: _Padre.ValorSeleccionad, \r\n                    _valCondicion: Campo.ValorCondicion, \r\n                    _operador: Coalesce(Campo.Condicion, \"=\") \r\n                },\r\n                    Switch(_operador,\r\n                        Var_JSONOperadores.Igual,  Trim(Lower(Text(_valPadre))) = Trim(Lower(Text(_valCondicion))),\r\n                        Var_JSONOperadores.Mayor,  Value(Coalesce(_valPadre, \"0\")) > Value(Coalesce(_valCondicion, \"0\")),\r\n                        Var_JSONOperadores.Menor,  Value(Coalesce(_valPadre, \"0\")) < Value(Coalesce(_valCondicion, \"0\")),\r\n                        Var_JSONOperadores.MayorIgual,  Value(Coalesce(_valPadre, \"0\")) >= Value(Coalesce(_valCondicion, \"0\")),\r\n                        Var_JSONOperadores.MenorIgual, Value(Coalesce(_valPadre, \"0\")) <= Value(Coalesce(_valCondicion, \"0\")),\r\n                        false\r\n                    )\r\n                )\r\n            )\r\n        )\r\n    ) && \r\n    (\r\n        // REGLA 3: Si cumple lo anterior, verificamos si está vacío (Error)\r\n        // Caso A: El valor principal está vacío y no hay excepción activada  && !Campo.ValorExcepcion\r\n        //(IsBlank(Trim(Text(Campo.ValorSeleccionad))) && !Campo.ExcesoPesoDetectado ) ||\r\n        \r\n        // Caso B: Hay una excepción activada (ej. \"Otros\") pero el texto explicativo está vacío\r\n        //(Campo.ExcesoPesoDetectado && IsBlank(Trim(Campo.TextoExcepcion)))\r\n        \r\n        If(\r\n                Campo.ExcesoPesoDetectado,\r\n                // Si hay exceso, el error depende SOLO de si el texto de excepción está vacío\r\n                IsBlank(Trim(Campo.TextoExcepcion)),\r\n                \r\n                // Si NO hay exceso, el error depende de si el valor seleccionado está vacío\r\n                IsBlank(Campo.ValorSeleccionad) || Trim(Text(Campo.ValorSeleccionad)) = \"\"\r\n            )\r\n    ),\r\n    { HasError: true }\r\n);\r\n\r\n\r\n// 2. CÁLCULO DE ESTADOS LOGICOS\r\nWith(\r\n    {\r\n        // Validación Cabecera Fija\r\n        BaseOK: \r\n            !IsBlank(Sol_Cbx_NuevoTicketGerencia_1.Selected.Nombre) && \r\n            !IsBlank(Sol_Cbx_NuevoTicketArea_1.Selected.Area) && \r\n            !IsBlank(Sol_Cbx_NuevoTicketSubarea_1.Selected.SubArea) &&\r\n            !IsBlank(Sol_Cbx_NuevoTicketCategoria_1.Selected.Nombre) &&  \r\n            !IsBlank(Sol_Cbx_NuevoTiposolicitud_1.Selected.TipoSolicitud) &&\r\n            !IsBlank(Sol_Cbx_NuevoTicketNiveldeconfidencialidad_1.Selected.Value),\r\n\r\n        // Validación Visto Bueno (Archivos)\r\n        /*\r\n        ArchivosOK: \r\n            If(\r\n                varTipoSolicitudSelected.VistoBueno;\r\n                CountRows(Filter(Var_uploadFile_listeAttachmentDatosAdjuntos; Tipo = Label20_56.Text)) > 0;\r\n                true\r\n            );\r\n        */\r\n        _confP: LookUp(colFormularioDinamicoCabeceraPaisSociedadNuevoTicket, Etiqueta = \"País\"),\r\n        _confS: LookUp(colFormularioDinamicoCabeceraPaisSociedadNuevoTicket, Etiqueta = \"Sociedad\")\r\n    },\r\n    \r\n    With(\r\n        {\r\n            PaisOK: //If(_confP.Obligatorio = \"Sí\"; !IsBlank(varPaisNuevoTicketSelected.Nombre); true)\r\n            \r\n            If(\r\n                _confP.Obligatorio = \"Requerido\",\r\n                If(_confP.Varios, CountRows(Sol_Cbx_NuevoTicketPais_1.SelectedItems) > 0, !IsBlank(Sol_Cbx_NuevoTicketPais_1.Selected.Nombre)),\r\n                true\r\n            )\r\n            ,\r\n            SociedadOK: If(\r\n                _confS.Obligatorio = \"Requerido\",\r\n                If(_confS.Varios, CountRows(Sol_Cbx_NuevoTicketSociedad_1.SelectedItems) > 0, !IsBlank(Sol_Cbx_NuevoTicketSociedad_1.Selected.Sociedad)),\r\n                true\r\n            ),\r\n            CamposDinamicosOK: IsEmpty(Filter(colFormularioDinamicoNuevoTicket, HasError = true)),\r\n            ValorPaisLista: If(_confP.Varios, \"Varios\", Sol_Cbx_NuevoTicketPais_1.Selected.Nombre),\r\n            ValorPaisConcat: If(_confP.Varios, Concat(Sol_Cbx_NuevoTicketPais_1.SelectedItems, Nombre, \";\"), Sol_Cbx_NuevoTicketPais_1.Selected.Nombre ),\r\n\r\n\r\n            ValorSociedadLista: If(_confS.Varios, \"Varios\", Sol_Cbx_NuevoTicketSociedad_1.Selected.Sociedad),\r\n            ValorSociedadConcat: If(_confS.Varios, Concat(Sol_Cbx_NuevoTicketSociedad_1.SelectedItems, Sociedad, \";\"), Sol_Cbx_NuevoTicketSociedad_1.Selected.Sociedad)\r\n        },\r\n\r\n        With(\r\n            {\r\n                AgrupadoExiste: !IsBlank(\r\n                    // modificar la busqueda del nivel confidencial\r\n\r\n                    Switch(Sol_Cbx_NuevoTicketNiveldeconfidencialidad_1.Selected.Value,\r\n                    \"Público\",LookUp(\r\n                        'LCP-001_List_RolGerenciaAreaSubAreaPaisSoc',\r\n                        Gerencia = Sol_Cbx_NuevoTicketGerencia_1.Selected.Nombre &&\r\n                        Area = Sol_Cbx_NuevoTicketArea_1.Selected.Area &&\r\n                        SubArea = Sol_Cbx_NuevoTicketSubarea_1.Selected.SubArea &&\r\n                        Pais = ValorPaisLista &&     // ValorPaisLista\r\n                        Sociedad = ValorSociedadLista && // ValorSociedadLista\r\n                        Rol = Var_RolApp.RolAnalista\r\n                    ).ID,\"Restringido\",LookUp(\r\n                        'LCP-001_List_RolGerenciaAreaSubAreaPaisSoc',\r\n                       