+ _pesoArchivoReal) > varLimiteSeccionBytes,\n                            UpdateIf(colFormularioDinamicoNuevoTicket, ID = _idActual, { ExcesoPesoDetectado: true });\n                            Collect(colErroresAdjuntos, { Tipo: \"TamanoSeccion\" }),\n                            \n                            // --- CASO B: ÉXITO (Guardamos el Base64 real y el puntero) ---\n                            Collect(\n                                Var_uploadFile_listeAttachmentTicketDinamico,\n                                {\n                                    nombre: _idActual & \"_\" & Fila.Name,\n                                    contenido: Fila.Value, // El Blob/Puntero nativo para transferir a Flow\n                                    contenidoBase64: _base64Puro, // Por si tu Power Automate requiere el string Base64 explícito\n                                    PesoBytes: _pesoArchivoReal, // Guardará los bytes exactos (ej: 10240 para 10KB)\n                                    label: _labelActual\n                                }\n                            );\n                            UpdateIf(\n                                colFormularioDinamicoNuevoTicket, \n                                ID = _idActual, \n                                { ExcesoPesoDetectado: (_pesoActualSeccion + _pesoArchivoReal) > varLimiteSeccionBytes }\n                            )\n                        )\n                    )\n                )\n            )\n        )\n    )\n);\n\n// 2️⃣ ACTUALIZACIÓN DE ALTURA Y SINCRONIZACIÓN ESPEJO\nWith(\n    { \n        _archivosDeEsteLabel: ShowColumns(Filter(Var_uploadFile_listeAttachmentTicketDinamico, label = _labelActual), nombre),\n        _registroMaestro: LookUp(colFormularioDinamicoNuevoTicket, ID = _idActual)\n    },\n    With(\n        {\n            _mostrarExcepcion: _registroMaestro.ExcesoPesoDetectado,\n            _altGal: If(CountRows(_archivosDeEsteLabel) > 3, 135, CountRows(_archivosDeEsteLabel) * 45)\n       