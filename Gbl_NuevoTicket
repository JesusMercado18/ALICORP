                                                Visible: "=// Propiedad: Visible del campo SiNo\nThisItem.Tipo = Var_JSONConfigurarTipoCampo.SiNo && (\n    \n    // 2. Si no depende de nadie, se rige por su propia visibilidad del JSON\n    If(IsBlank(ThisItem.DependeDe), \n        ThisItem.Visible, \n\n        // 3. ESTRATEGIA: Buscamos primero el registro del padre en la colección consolidada\n        With(\n            { \n                _padre: LookUp(colConsolidada, Label = ThisItem.DependeDe)\n            },\n            \n            // CORRECCIÓN CRÍTICA: Si el padre no tiene ninguna selección o está vacío, el dependiente se oculta\n            If(IsBlank(_padre) || IsBlank(_padre.ValorSeleccionad),\n                false,\n                \n                Switch(\n                    ThisItem.Condicion,\n                    \n                    // Si la condición es \"Igual\", comparamos los textos limpios\n                    Var_JSONOperadores.Igual, Text(_padre.ValorSeleccionad) = Text(ThisItem.ValorCondicion),\n                    \n                    // Si la condición es \"DiferenteDe\", validamos que no coincidan (reemplazando el <> que traías para usar el mismo formato)\n                    Var_JSONOperadores.DiferenteDe, Text(_padre.ValorSeleccionad) <> Text(ThisItem.ValorCondicion),\n                    \n                    // Para operadores matemáticos\n                    Var_JSONOperadores.Mayor, Value(_padre.ValorSeleccionad) > Value(ThisItem.ValorCondicion),\n                    Var_JSONOperadores.Menor, Value(_padre.ValorSeleccionad) < Value(ThisItem.ValorCondicion),\n                    Var_JSONOperadores.MayorIgual, Value(_padre.ValorSeleccionad) >= Value(ThisItem.ValorCondicion),\n                    Var_JSONOperadores.MenorIgual, Value(_padre.ValorSeleccionad) <= Value(ThisItem.ValorCondicion),\n                    \n                    false\n                )\n            )\n        )\n    )\n)"
