    Properties:
      LoadingSpinnerColor: =RGBA(56, 96, 178, 1)
      OnVisible: "=// =============================================================================\r\n// PHASE 1: PRIORIDAD ALTA - RESOLUCIÓN INMEDIATA DE VARIABLES PARA COMBOBOXES\r\n// =============================================================================\r\nClearCollect(col_Adn_TipoSolicitudNuevoTicket, 'LCP-001_List_Configuracion_Ticket');\r\n\r\nUpdateContext({ \r\n    varGerenciaTipoSolicitudSelected: If(Ctx_IngresoDesdeCatalogo, {Value: Ctx_StrGerencia}, Blank()), \r\n    varAreaTipoSolicitudSelected: If(Ctx_IngresoDesdeCatalogo, {Value: Ctx_StrArea}, Blank()), \r\n    varSubAreaTipoSolicitudSelected: If(Ctx_IngresoDesdeCatalogo, {Value: Ctx_StrSubArea}, Blank()),\r\n    varRolAnalistaTipoSolicitudSelected: If(Ctx_IngresoDesdeCatalogo, {Value: Ctx_StrCategoria}, Blank()),\r\n    varTipoSolicitudSelected: If(Ctx_IngresoDesdeCatalogo, LookUp(col_Adn_TipoSolicitudNuevoTicket, TipoSolicitud = Ctx_StrTipoSol), Blank())\r\n});\r\n\r\n// Limpiezas preventivas rápidas en memoria local\r\nClear(colSociedadNuevoTicket);\r\nClear(colLocalPais);\r\nClear(Var_uploadFile_listeAttachmentTicketDinamico);\r\nClear(colFormularioDinamicoNuevoTicket);\r\n\r\nUpdateContext({\r\n    menuSelected: 3,\r\n    varShowErrors: false,\r\n    Var_CmcLoadingSpinnerVisible: false,\r\n    Var_CmcLoadingSpinnerVisibleEnviar: false\r\n});\r\n\r\n// =============================================================================\r\n// PHASE 2: PROCESAMIENTO ASÍNCRONO EN PARALELO (CONCURRENT)\r\n// En esta sección agrupamos las cargas más pesadas para que corran en hilos separados.\r\n// =============================================================================\r\n\r\nClearCollect(\r\n        colFeriados,\r\n        AddColumns(\r\n            Filter('LCP-001_List_CalendarioFestivo', Pais = Var_ProfileUser.Pais && Sociedad = Var_ProfileUser.Sociedad),\r\n            FechaCompleta,\r\n            If(Len(FechaFestiva) = 10,\r\n                DateValue(FechaFestiva),\r\n                Date(Year(Now()), Value(Mid(FechaFestiva, 4, 2)), Value(Left(FechaFestiva, 2)))\r\n            )\r\n        )\r\n    );\r\n\r\n// =============================================================================\r\n// PHASE 3: EJECUCIÓN DE LÓGICA DINÁMICA DE PARSEADO JSON Y PAÍSES\r\n// =============================================================================\r\nIf(\r\n    Ctx_IngresoDesdeCatalogo,\r\n    \r\n    UpdateContext({ varOpenDropDownTipoSolicitud: false });\r\n\r\n    If(varAreaTipoSolicitudSelected.Value in [\"Nóminas Perú\", \"Nóminas Países\"],\r\n        ClearCollect(colLocalPais, RenameColumns(ShowColumns(Filter('LCP-001_List_PaisSubArea', SubArea = varAreaTipoSolicitudSelected.Value), Pais), Pais, Nombre))\r\n    ,\r\n        ClearCollect(colLocalPais, col_gblPais)\r\n    );\r\n\r\n    If(!IsBlank(varTipoSolicitudSelected),\r\n        // Carga y parseo de campos JSON de la solicitud seleccionada\r\n        With(\r\n            { _jsonTable: Table(ParseJSON(Trim(varTipoSolicitudSelected.CamposAdicionalesTicket))) },\r\n            ClearCollect(\r\n                colFormularioDinamicoNuevoTicket,\r\n                ForAll(\r\n                    Sequence(CountRows(_jsonTable)), \r\n                    With(\r\n                        { _registro: Index(_jsonTable, Value).Value }, \r\n                        {\r\n                            ID: Value, \r\n                            Label: Text(_registro.label),\r\n                            Tipo: Text(_registro.Tipo),\r\n                            Open: false,\r\n                            Opciones: Text(_registro.Opciones), \r\n                            Visible: Text(_registro.Visible) = \"Sí\",\r\n                            Configuracion: Text(_registro.configuracion),\r\n                            Condicion: Coalesce(Text(_registro.Condicion), \"=\"), \r\n                            ValorCondicion: Text(_registro.ValorCondicion),\r\n                            DependeDe: Text(_registro.DependeDe),\r\n                            Otros: Boolean(_registro.Otros),\r\n                            Valores: Text(_registro.Valores),\r\n                            ValorSeleccionad: \"\", \r\n                            ValorEncontrado: \"\",\r\n                            CatalogoAutocompletado: Text(_registro.CatalogoAutocompletado),\r\n                            MostrarColumnaFiltrada: Text(_registro.MostrarColumnaFiltrada),\r\n                            Regla: Boolean(_registro.Regla),\r\n                            DiccionarioRegla: Text(_registro.DiccionarioRegla),\r\n                            TextoGuia: Text(_registro.TextoGuia),\r\n                            ReglaFecha: Boolean(_registro.ReglaFecha),\r\n                            CondicionAdicional: Text(_registro.CondicionAdicional),\r\n                            DependeDeAdicional: Text(_registro.DependeDeAdicional),\r\n                            DependeDeAutocompletado: Text(_registro.DependeDeAutocompletado),\r\n                            HasError: false,\r\n                            AlturaCampo: If(Text(_registro.Tipo) in [Var_JSONConfigurarTipoCampo.Texto, Var_JSONConfigurarTipoCampo.URL, Var_JSONConfigurarTipoCampo.Numerico], 60, \r\n                                           Text(_registro.Tipo) = Var_JSONConfigurarTipoCampo.Multiline, 80, \r\n                                           Text(_registro.Tipo) = Var_JSONConfigurarTipoCampo.Adjunto, 88, 60) \r\n                                         + If(IsBlank(Text(_registro.TextoGuia)), 0, 46),\r\n                            FechaReferencia: Today(),\r\n                            SelectorMesAño: false,\r\n                            ExcesoPesoDetectado: false,\r\n                            PermiteExcepcion: true,\r\n                            ValorExcepcion: false,\r\n                            TextoExcepcion: \"\",\r\n\r\n                            VistaAutocompletado: Text(_registro.VistaAutocompletado)\r\n                        }\r\n                    )\r\n                )\r\n            )\r\n        );\r\n\r\n        With(\r\n            { _jsonTable: Table(ParseJSON(Trim(varTipoSolicitudSelected.CabeceraPaisSociedad))) },\r\n            ClearCollect(\r\n                colFormularioDinamicoCabeceraPaisSociedadNuevoTicket,\r\n                ForAll(\r\n                    _jsonTable,\r\n                    {\r\n                        Etiqueta: Text(ThisRecord.Value.Etiqueta),\r\n                        Obligatorio: Text(ThisRecord.Value.Obligatorio),\r\n                        TipoCampo: Text(ThisRecord.Value.TipoCampo),\r\n                        Visible: Boolean(ThisRecord.Value.Visible),\r\n                        Varios: Boolean(ThisRecord.Value.Varios),\r\n                        ValorSeleccionado: \"\",\r\n                        Valores: ForAll(\r\n                            Table(ThisRecord.Value.Valores),\r\n                            { Value: Text(ThisRecord.Value.Value) }\r\n                        )\r\n                    }\r\n                )\r\n            )\r\n        );\r\n\r\n        With(\r\n            { _recordPais: LookUp(colFormularioDinamicoCabeceraPaisSociedadNuevoTicket, Etiqueta = \"País\") },\r\n            If(!IsBlank(_recordPais.Valores),\r\n                ClearCollect(colLocalPais, Filter(col_gblPais, Nombre in _recordPais.Valores.Value))\r\n            ,\r\n                ClearCollect(colLocalPais, col_gblPais)\r\n            )\r\n        );\r\n\r\n        ClearCollect(colDescargarPlantilla, Filter('LCP-001_Library_AdjuntosConfiguracion', CodigoConfiguracion = Text(varTipoSolicitudSelected.ID)))\r\n    )\r\n,\r\n    // Bloque Else: Limpieza estándar si entra directo sin catálogo\r\n    UpdateContext({\r\n        varGerenciaTipoSolicitudSelected: Blank(),\r\n        varAreaTipoSolicitudSelected: Blank(),\r\n        varSubAreaTipoSolicitudSelected: Blank(),\r\n        varTipoSolicitudSelected: Blank(),\r\n        varRolAnalistaTipoSolicitudSelected: Blank()\r\n    })\r\n);\r\n\r\n// =============================================================================\r\n// PHASE 4: ASENTAMIENTO DE LA UI (RESETS CRUCIALES)\r\n// =============================================================================\r\nReset(Sol_Cbx_NuevoTicketGerencia_1);\r\nReset(Sol_Cbx_NuevoTicketArea_1);\r\nReset(Sol_Cbx_NuevoTicketSubarea_1);\r\nReset(Sol_Cbx_NuevoTicketCategoria_1);\r\nReset(Sol_Cbx_NuevoTiposolicitud_1);\r\nReset(Sol_Cbx_NuevoTicketNiveldeconfidencialidad_1);\r\nReset(Sol_Cbx_NuevoTicketContactoderespaldo_1);\r\nReset(Sol_Cbx_NuevoTicketPais_1);\r\nReset(Sol_Cbx_NuevoTicketSociedad_1);\r\nReset(Gbl_TxtDescripcionNuevoTicket_2);\r\nReset(Gbl_Attachment_AdjuntosAdicionales_2);\r\n\r\n// Protegemos el estado de la bandera usando evaluación perezosa\r\nUpdateContext({ Ctx_IngresoDesdeCatalogo: If(IsBlank(Sol_Cbx_NuevoTicketGerencia_1.Selected.Nombre), Ctx_IngresoDesdeCatalogo, false) });"
