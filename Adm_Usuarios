Screens:
  Adm_Usuarios:
    Properties:
      Fill: =ColorValue(Var_ColorFondoLateral)
      LoadingSpinnerColor: =RGBA(0, 120, 212, 1)
      OnVisible: |-
        =//----Variables-----
        //UpdateContext({menuSelected: 5});; //Falta agregar el numero de indice que tiene en el menu
        Reset(AdmUsr_TxtIBuscarDocumento);

        Switch(Var_RolSistema,
            "Administrador",
            ClearCollect(colQuerysAdmUsuarios,
                { input: "ID", mark: false, query: "" },
                { input: "Codigo", mark: false, query: "" },
                { input: "Nombre0", mark: false, query: "" },
                { input: "Apellido", mark: false, query: "" },
                { input: "Nombre", mark: false, query: "" },// Es NombreApellido
                { input: "CorreoUsuario", mark: false, query: "" },
                { input: "RolPerfil", mark: false, query: "" },
                { input: "RolSistema", mark: false, query: "" }, 
                { input: "Estado", mark: false, query: "" },
                { input: "Gerencia", mark: false, query: "" }
            ),
            "Supervisor",
            ClearCollect(colQuerysAdmUsuarios,
                { input: "ID", mark: false, query: "" },
                { input: "Codigo", mark: false, query: "" },
                { input: "Nombre0", mark: false, query: "" },
                { input: "Apellido", mark: false, query: "" },
                { input: "Nombre", mark: false, query: "" },
                { input: "CorreoUsuario", mark: false, query: "" },
                { input: "RolPerfil", mark: false, query: "" },
                { input: "RolSistema", mark: false, query: "" }, 
                { input: "Estado", mark: false, query: "" },
                { input: "Gerencia", mark: false, query: "" }
            ),
            //Resultado predeterminado
            ClearCollect(colQuerysAdmUsuarios,
                { input: "ID", mark: false, query: "" },
                { input: "Codigo", mark: false, query: "" },
                { input: "Nombre0", mark: false, query: "" },
                { input: "Apellido", mark: false, query: "" },
                { input: "Nombre", mark: false, query: "" },
                { input: "CorreoUsuario", mark: false, query: "" },
                { input: "RolPerfil", mark: false, query: "" },
                { input: "RolSistema", mark: false, query: "" }, 
                { input: "Estado", mark: false, query: "" },
                { input: "Gerencia", mark: false, query: "(substringof('" & Var_ProfileUser.Gerencia & "', Gerencia))" }
            )
        );

        Set(Var_GridPageSizeAdmUsuarios, 5);
        Set(Var_CurrentPageAdmUsuarios, 1);
        // Configuración para el motor:
        Set(Var_TargetIDAdmUsuarios, 0);
        Set(Var_DirectionAdmUsuarios, "NEXT");
        Set(Var_IsIndividualAdmUsuarios, false);

        Select(Spv_btn_MotorPaginacionUsuarios); // <--- Ejecuta la lógica

        UpdateContext({Var_SpvCmcLoadingSpinnerVisible: false});
