                                                          itemWidth: Self.TemplateWidth + Self.TemplatePadding
                                                      },
                                                      If(
                                                          totalPages <= maxVisible,
                                                          (totalPages * itemWidth) + itemWidth, 
                                                          maxVisible * itemWidth
                                                      )
