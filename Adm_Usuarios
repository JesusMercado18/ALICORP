                                                Items: |-
                                                  =If(
                                                      !IsBlank(TotalItemAdmUsuarios) && Var_GridPageSizeAdmUsuarios > 0,
                                                      Sequence(RoundUp(TotalItemAdmUsuarios / Var_GridPageSizeAdmUsuarios, 0), 1),
