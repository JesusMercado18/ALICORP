// Definición de la función global en App.Formulas
fxCalcularAncho(texto: Text): Number = With(
    {
        _factor: 7 / 16;
        _maxW: 280;
        _weights: Table(
            {
                Characters: "!;':,. i|";
                Weight: 4
            };
            {
                Characters: "l1()-[]{}fjrt*";
                Weight: 5
            };
            {
                Characters: "s_\/czj235^+=<>?aeoxflst6789$uv";
                Weight: 9
            };
            {
                Characters: "bdghknpqyexz04bcgkpry#&dhnouvaq%m@";
                Weight: 11
            };
            {
                Characters: "wM";
                Weight: 15
            };
            {
                Characters: "W";
                Weight: 17
            }
        )
    };
    With(
        {
            _sumaPura: Sum(
                AddColumns(
                    Split(
                        Lower(texto);
                        ""
                    );
                    CharW;
                    Coalesce(
                        LookUp(
                            _weights;
                            Find(
                                Value;
                                Characters
                            ) > 0;
                            Weight
                        );
                        10
                    )
                );
                CharW
            ) * _factor
        };
        With(
            {_anchoFinal: _sumaPura + 22 + (_sumaPura * 0,05)};
            Min(
                _anchoFinal;
                _maxW
            )
        )
    )
);;
// Creacion de la coleccion con columna tipada para ordenamiento cronologico
UDFAprobadoresCheck(
    //"Aprobado"
    //"Rechazado"
    pNuevoEstado: Text
): Void = 
{
	ClearCollect(
        colAprobadoresCheck;
        AddColumns(
            ForAll(
                Table(ParseJSON(Trim(Var_SpvTicketSeleccionada.AprobadoresCheck)));
                {
                    correo: Text(ThisRecord.Value.correo);
                    nombre: Text(ThisRecord.Value.nombre);
                    estado: Text(ThisRecord.Value.estado);
                    fecha: Text(ThisRecord.Value.fecha)
                }
            );
            FechaOrden;
            If(
                IsBlank(fecha) Or Len(fecha) < 8;
                Blank();
                DateTimeValue(
                    fecha;
                    "es-ES"
                )
            )
        )
    );;
    With(
        {
            varTargetRecord: First(
                Sort(
                    Filter(
                        colAprobadoresCheck;
                        correo = Var_ProfileUser.CorreoUsuario && IsBlank(estado)
                    );
                    FechaOrden;
                    SortOrder.Descending
                )
            )
        };
        If(
            !IsBlank(varTargetRecord.correo);
            Patch(
                colAprobadoresCheck;
                varTargetRecord;
                {
                    estado: pNuevoEstado;
                    fecha: Text(
                        Now();
                        "dd/mm/yyyy hh:mm:ss"
                    )
                }
            )
        )
    );;
    Set(
        Gbl_AprobadoresCheckJsonActualizado;
        JSON(
            colAprobadoresCheck;
            JSONFormat.Compact
        )
    )
};;
// aqui obtenemos los datos del solicitante, atendido por, responsable de atención de la tabla usuarios para poder calcular su SLA.
UDFObtenerDatosUsuarioDestino(pCorreo: Text) : Void = 
{
	Set(
        GDatoUsuario;
        LookUp(
            'LCP-001_List_Usuarios';
            CorreoUsuario = pCorreo
        )
    );;
    ClearCollect(
        colFeriados;
        AddColumns(
            Filter(
                'LCP-001_List_CalendarioFestivo';
                Pais = GDatoUsuario.Pais && Sociedad = GDatoUsuario.Sociedad
            );
            FechaCompleta;
            If(
                Len(FechaFestiva) = 10;
                DateValue(FechaFestiva);
                Date(
                    Year(Now());
                    Value(
                        Mid(
                            FechaFestiva;
                            4;
                            2
                        )
                    );
                    Value(
                        Left(
                            FechaFestiva;
                            2
                        )
                    )
                )
            )
        )
    )
};;
UDFCalcularSLAEstado(pEstadoSiguiente: Text): Void = 
{
	If(
        IsEmpty(
            Filter(
                'LCP-001_List_EstadosProceso';
                EstadoActual = pEstadoSiguiente
            )
        );
        Concurrent(
            Set(
                GVar_SLACalculado;
                0
            );
            Set(
                GFechaVencimientoEstado;
                Var_SpvTicketSeleccionada.FechaVencimiento
            )
        );
        /* PASO 1: Usamos With para aislar el 'auxSLA' de manera dinámica.
           Cada caso del Switch solo se encarga de ir a buscar su SLA correspondiente.
        */

        With(
            {
                vAuxSLA: LookUp(
                    'LCP-001_List_EstadosProceso';
                    EstadoActual = pEstadoSiguiente
                ).SLA
                /*
                Switch(
                    pEstadoSiguiente;
                    
                    Var_EstadosApp.EstadoObservado;
                    LookUp('LCP-001_List_EstadosProceso'; EstadoActual = Var_EstadosApp.EstadoObservado && EstadoSiguiente = Var_EstadosApp.EstadoEnRevision).SLA;
                    
                    Var_EstadosApp.EstadoDerivado;
                    LookUp('LCP-001_List_EstadosProceso'; EstadoActual = Var_EstadosApp.EstadoEnRevision && EstadoSiguiente = Blank()).SLA;
                    
                    Var_EstadosApp.EstadoEnProceso;
                    LookUp('LCP-001_List_EstadosProceso'; EstadoActual = Var_EstadosApp.EstadoEnProceso && EstadoSiguiente = Blank()).SLA;
                    
                    Var_EstadosApp.EstadoEnEsperaAprobacion;
                    LookUp('LCP-001_List_EstadosProceso'; EstadoActual = Var_EstadosApp.EstadoEnEsperaAprobacion && EstadoSiguiente = Var_EstadosApp.EstadoEnProceso).SLA;
                    
                    Var_EstadosApp.EstadoResuelto;
                    LookUp('LCP-001_List_EstadosProceso'; EstadoActual = Var_EstadosApp.EstadoResuelto && EstadoSiguiente = Var_EstadosApp.EstadoCerrado).SLA;
                    
                    // Caso por defecto si no coincide con ninguno de los anteriores
                    0
                )
                */

            };
            /* PASO 2: Lógica unificada para procesar el SLA. 
               Se ejecuta UNA SOLA VEZ usando la variable calculada 'vAuxSLA'.
            */

            Set(
                GVar_SLACalculado;
                If(
                    IsBlank(vAuxSLA) || vAuxSLA = 0;
                    0;
                    If(
                        Value(Spv_TxtAsignarSLATiempoAtencionDetalleTicket_1.Text) <> vAuxSLA;
                        Value(Spv_TxtAsignarSLATiempoAtencionDetalleTicket_1.Text);
                        vAuxSLA
                    )
                )
            );;
            /* PASO 3: Lógica unificada para el cálculo de fechas y días hábiles.
            */If(
                GVar_SLACalculado = 0;
                Set(
                    GFechaVencimientoEstado;
                    Var_SpvTicketSeleccionada.FechaVencimiento
                );
                // Si el SLA es mayor a 0, generamos la colección de días laborables

                ClearCollect(
                    colFechas;
                    AddColumns(
                        Sequence(GVar_SLACalculado * 3);
                        Fecha;
                        DateAdd(
                            Now();
                            Value;
                            TimeUnit.Days
                        )
                    )
                );;
                ClearCollect(
                    colDiasHabiles;
                    FirstN(
                        Filter(
                            colFechas;
                            Weekday(
                                Fecha;
                                StartOfWeek.Monday
                            ) <= 5 && IsBlank(
                                LookUp(
                                    colFeriados;
                                    FechaCompleta = Fecha
                                )
                            )
                        );
                        GVar_SLACalculado
                    )
                );;
                Set(
                    GFechaVencimientoEstado;
                    Last(colDiasHabiles).Fecha
                )
            )
        )
    )
};;
