// UDF NIVEL DE CONFIDENCIALIDAD (DERIVAR Y REASIGNAR)

UDFBuscarUsuariosNivelConfincialidad(pNivelConfidencial: Text ;  pGerencia : Text ; pArea : Text; pSubArea : Text) : Void = {

Set(Var_RolSpv;

    Switch(pNivelConfidencial; 
    "Público"; 
    LookUp(
        'LCP-001_List_RolGerenciaAreaSubAreaPaisSoc';
        And(
        Gerencia = pGerencia;
        Area = pArea;
        SubArea = pSubArea;
        Rol = Var_RolApp.RolAnalista
        )
    ).RolGeneralNombre;
    "Restringido";
    LookUp(
        'LCP-001_List_RolGerenciaAreaSubAreaPaisSoc';
        And(
                Rol = Var_RolApp.RolSupervisor;
                Or(
                    // Casuística 1: Por Gerencia, Área y SubÁrea
                    And(
                        Gerencia = pGerencia;
                        Area = pArea;
                        SubArea = pSubArea
                    );
                    // Casuística 2: Por Gerencia y Área (cuando no aplique SubÁrea)
                    And(
                        Gerencia = pGerencia;
                        Area = pArea
                    )
                )
            )
    ).RolGeneralNombre
    ; 
    "Alta Gerencia";
    
    LookUp(
        'LCP-001_List_RolGerenciaAreaSubAreaPaisSoc';
        And(
        Gerencia = pGerencia;
        Rol = Var_RolApp.RolGerente
        )
    ).RolGeneralNombre
    )
     
)



}